---

/*
 *  ----------------------------------------------------------------  *
 *  -----  Layout.astro  --  /client/src/layouts/Layout.astro  -----  *
 *  ----------------------------------------------------------------  *
 */

import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';


interface Props {
    title: string;
    heading: string;
    subtitle: string;
    active: 'dashboard' | 'tasks' | 'reports';
    /** Encaja el contenido en el viewport sin scroll de página */
    fitViewport?: boolean;
    /** Fecha (YYYY-MM-DD): muestra el calendario compacto en el sidebar */
    calendarDate?: string;
}

const {
    title,
    heading,
    subtitle,
    active,
    fitViewport = false,
    calendarDate,
} = Astro.props;


---


<!doctype html>
<html lang="es">
    
    <head>
        
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <meta
            name="description"
            content="Dashboard de gestión de tareas y control del tiempo invertido"
        />
        
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" id="app-favicon" />
        
        <script is:inline>
            (() => {
                /**
                 * -----------------------------
                 * -----  `bootTheme()`  -----
                 * -----------------------------
                 * - Resuelve el tema inicial y lo aplica antes del primer render.
                 */

                const key = 'theme';
                const stored = localStorage.getItem(key);

                const theme =
                    stored === 'light' || stored === 'dark'
                        ? stored
                        : window.matchMedia('(prefers-color-scheme: light)').matches
                          ? 'light'
                          : 'dark';

                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.style.colorScheme = theme;

                /*
                    *  ---------------------------------  *
                    *  -----  Referencias al HTML  -----  *
                    *  ---------------------------------  *
                */

                // - `Enlace del favicon de la aplicación`
                const favicon = document.getElementById('app-favicon');

                //  -----  si existe el favicon y es un link, sincronizarlo con el tema  -----
                if (favicon instanceof HTMLLinkElement) {
                    favicon.href =
                        theme === 'dark'
                            ? '/favicon-light.svg'
                            : '/favicon-dark.svg';
                }
            })();
        </script>
        
        <ClientRouter />
        
        <title>
            {title}
        </title>

    </head>
    
    
    <body>
        
        <!--  -----  shell de la página  ----- -->
        <div 
            class:list={[
                'shell', 
                { 'fit-viewport': fitViewport }
            ]}
        >
            
            <!--  -----  sidebar de la página  ----- -->
            <Sidebar 
                active={active} 
                calendarDate={calendarDate} 
            />

            <!--  -----  contenido de la página  ----- -->
            <div class="content">
                
                <!--  -----  header de la página  ----- -->
                <header class="page-header">
                    
                    <!--  -----  texto del header  ----- -->
                    <div class="page-header-text">
                        <h1>{heading}</h1>
                        <p>{subtitle}</p>
                    </div>
                    
                    <!--  -----  botón de cambio de tema  ----- -->
                    <button
                        type="button"
                        class="theme-toggle"
                        id="theme-toggle"
                        aria-label="Cambiar tema"
                        title="Cambiar tema"
                    >
                        <span class="theme-icon theme-icon-sun" aria-hidden="true"> ☀ </span>
                        <span class="theme-icon theme-icon-moon" aria-hidden="true"> ☾ </span>
                        <span class="theme-label" data-theme-label>Tema</span>
                    </button>

                </header>

                <!--  -----  contenido principal de la página  ----- -->
                <main class="page-main">
                    <slot />
                </main>

            </div>

        </div>

    </body>

</html>



<script>
    import {
        applyTheme,
        resolveTheme,
        toggleTheme,
        type Theme,
    } from '../lib/theme';


    // ClientRouter reemplaza el documento: reaplicar el tema tras cada navegación.

    /**
     * ---------------------------
     * -----  `syncTheme()`  -----
     * ---------------------------
     * - Aplica el tema actual al documento.
     * - Se ejecuta después de cada navegación.
     */
    const syncTheme = (): void => applyTheme(resolveTheme());

    //  -----  se ejecuta después de cada navegación  -----
    document.addEventListener('astro:after-swap', syncTheme);

    //  -----  se ejecuta al cargar la página  -----
    syncTheme();


    /**
     * --------------------------------------
     * -----  `labelFor(theme: Theme)`  -----
     * --------------------------------------
     * - Obtiene el label del botón de cambio de tema.
     */
    const labelFor = (theme: Theme): string =>
        theme === 'dark' ? 'Modo oscuro' : 'Modo claro';


    /**
     * ---------------------------
     * -----  `syncToggle()`  -----
     * ---------------------------
     * - Sincroniza el botón de cambio de tema con el tema actual.
     */
    const syncToggle = (): void => {
        const theme = resolveTheme();

        /*
            *  ---------------------------------  *
            *  -----  Referencias al HTML  -----  *
            *  ---------------------------------  *
        */

        // - `Botón para alternar el tema`
        const button = document.getElementById(
            'theme-toggle',
        ) as HTMLButtonElement | null;

        //  -----  si el botón no existe, no sincronizar nada  -----
        if (!button) return;

        //  -----  button: establece el aria-label y el title del botón de cambio de tema  -----
        button.setAttribute(
            'aria-label',
            theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
        );

        //  -----  button: establece el title del botón de cambio de tema  -----
        button.title =
            theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';

        // - `Texto visible del botón de tema`
        const label = button.querySelector(
            '[data-theme-label]',
        ) as HTMLSpanElement | null;

        //  -----  si existe la etiqueta, actualizar su texto  -----
        if (label) {
            label.textContent = labelFor(theme);
        }

    };


    /**
     * ---------------------------
     * -----  `bindToggle()`  -----
     * ---------------------------
     * - Vincula el evento click al botón de cambio de tema.
     */
    const bindToggle = (): void => {
        /*
            *  ---------------------------------  *
            *  -----  Referencias al HTML  -----  *
            *  ---------------------------------  *
        */

        // - `Botón para alternar el tema`
        const button = document.getElementById(
            'theme-toggle',
        ) as HTMLButtonElement | null;

        //  -----  si el botón no existe, salir  -----
        if (!button) return;

        //  -----  si el botón ya está vinculado, solo resincronizar  -----
        if (button.dataset.bound === 'true') {
            syncToggle();
            return;
        }

        button.dataset.bound = 'true';

        button.addEventListener('click', () => {
            toggleTheme();
            syncToggle();
        });

        syncToggle();
    };

    //  -----  se ejecuta al cargar la página  -----
    document.addEventListener('astro:page-load', bindToggle);

    //  -----  se vincula el evento click al botón de cambio de tema -----
    bindToggle();

</script>

<style>
    
    .shell {
        display: grid;
        grid-template-columns: 300px 1fr;
        min-height: 100vh;
    }

    .shell.fit-viewport {
        height: 100dvh;
        min-height: 0;
        overflow: hidden;
    }

    .content {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .shell.fit-viewport .content {
        min-height: 0;
        overflow: hidden;
    }

    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.5rem 0.9rem;
        background-color: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
    }

    .shell.fit-viewport .page-header {
        padding-block: 0.85rem 0.7rem;
        flex-shrink: 0;
    }

    .page-header-text {
        min-width: 0;
    }

    .page-header h1 {
        font-size: 1.5rem;
    }

    .page-header p {
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .theme-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
        padding: 0.5rem 0.85rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: none;
        color: var(--color-text);
        font-size: 0.88rem;
        font-weight: 500;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease;
    }

    .theme-toggle:hover {
        background-color: var(--color-surface-hover);
        border-color: var(--color-primary);
    }

    .theme-icon {
        width: 1.1rem;
        text-align: center;
        line-height: 1;
    }

    .theme-icon-sun {
        display: none;
    }

    .theme-icon-moon {
        display: inline;
    }

    :global([data-theme='light']) .theme-icon-sun {
        display: inline;
    }

    :global([data-theme='light']) .theme-icon-moon {
        display: none;
    }

    .page-main {
        padding: 1.25rem 1.5rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .shell.fit-viewport .page-main {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        padding-block: 1rem 1.25rem;
        gap: 0;
    }

    /* El hijo directo debe ocupar el alto del main; si vive solo en el
       <style> de cada página, ClientRouter a veces no lo aplica hasta
       recargar y el scroll interno no aparece. */
    .shell.fit-viewport .page-main > :global(*) {
        flex: 1;
        min-height: 0;
    }

    @media (max-width: 900px) {
        .shell {
            grid-template-columns: 1fr;
        }

        .page-header,
        .page-main {
            padding-inline: 1.25rem;
        }

        .page-header {
            padding-block: 1rem 0.85rem;
        }

        .shell.fit-viewport {
            /* En pantallas pequeñas se permite el scroll de página en lugar
               del scroll interno del contenedor de tareas. */
            height: auto;
            /* svh: estable al mostrar/ocultar la barra del navegador (dvh salta). */
            min-height: 100svh;
            overflow: visible;
            /* Menú (+ calendario acoplado) arriba; el contenido fluye */
            grid-template-rows: auto auto;
            /* Sin esto, el espacio sobrante se reparte entre filas
               y el aside/calendario queda con un hueco enorme debajo. */
            align-content: start;
        }

        .shell.fit-viewport .content {
            overflow: visible;
            flex: none;
            min-height: 0;
        }

        .shell.fit-viewport .page-header {
            padding-block: 1rem 0.85rem;
        }

        .shell.fit-viewport .page-main {
            flex: none;
            min-height: 0;
            overflow: visible;
            padding-block: 0.85rem 1rem;
        }

        .shell.fit-viewport .page-main > :global(*) {
            flex: none !important;
            min-height: 0;
            max-height: none;
            height: auto;
        }
    }

    @media (max-width: 600px) {
        .page-header {
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            align-items: center;
        }

        .page-header h1 {
            font-size: 1.25rem;
            line-height: 1.2;
        }

        .page-header p {
            font-size: 0.82rem;
            margin-top: 0.15rem;
        }

        .theme-toggle {
            gap: 0.35rem;
            padding: 0.4rem 0.55rem;
            font-size: 0.78rem;
        }

        .theme-label {
            /* Solo icono: el texto aprieta el título del día */
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    }

    @media (max-width: 400px) {
        .page-header,
        .page-main {
            padding-inline: 0.7rem;
        }

        .page-header h1 {
            font-size: 1.15rem;
        }

        .page-header p {
            font-size: 0.78rem;
        }
    }
</style>

<style is:global>
    :root,
    [data-theme='dark'] {
        color-scheme: dark;
        --color-bg: #0f1117;
        --color-surface: #1a1d27;
        --color-surface-hover: #232737;
        --color-border: #2e3347;
        --color-text: #e6e8ef;
        --color-text-muted: #8b90a3;
        --color-primary: #5b8def;
        --color-primary-hover: #74a0f2;
        --color-danger: #e5626c;
        --color-danger-hover: #ec7a83;
        --color-success: #4fbf8b;
        --color-warning: #e5a34d;
        --radius: 10px;
        --shadow: 0 4px 16px rgb(0 0 0 / 0.35);
        /* Icono claro sobre UI oscura */
        --logo-outer-top: #e4e8f1;
        --logo-outer-bottom: #d0d6e4;
        --logo-inner: #ffffff;
        --logo-stroke: #c4cad8;
        --logo-ring: #5c6478;
    }

    [data-theme='light'] {
        color-scheme: light;
        --color-bg: #eef1f7;
        --color-surface: #ffffff;
        --color-surface-hover: #e4e8f1;
        --color-border: #d0d6e4;
        --color-text: #1a1d27;
        --color-text-muted: #5c6478;
        --color-primary: #3d6fd9;
        --color-primary-hover: #2f5fc4;
        --color-danger: #d94852;
        --color-danger-hover: #c53a44;
        --color-success: #2f9e6f;
        --color-warning: #c9842a;
        --shadow: 0 4px 16px rgb(26 29 39 / 0.08);
        /* Icono oscuro sobre UI clara */
        --logo-outer-top: #232737;
        --logo-outer-bottom: #151823;
        --logo-inner: #0f1117;
        --logo-stroke: #2e3347;
        --logo-ring: #8b90a3;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family:
            'Segoe UI',
            system-ui,
            -apple-system,
            sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
        line-height: 1.5;
    }

    button {
        font-family: inherit;
        cursor: pointer;
    }

    /* ----------------------  Scroll personalizado  ---------------------- */

    /* Firefox */
    :root {
        scrollbar-width: thin;
        scrollbar-color: color-mix(
                in srgb,
                var(--color-primary) 70%,
                transparent
            )
            transparent;
    }

    /* Chrome, Edge y Safari (documento y paneles con scroll) */
    ::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background-color: color-mix(
            in srgb,
            var(--color-primary) 65%,
            transparent
        );
        border-radius: 999px;
        /* Hueco alrededor del pulgar para que "flote" sobre el track */
        border: 2px solid var(--color-bg);
        background-clip: padding-box;
        min-height: 3rem;
    }

    ::-webkit-scrollbar-thumb:hover {
        background-color: color-mix(
            in srgb,
            var(--color-primary) 90%,
            transparent
        );
    }

    ::-webkit-scrollbar-thumb:active {
        background-color: var(--color-primary-hover);
    }

    ::-webkit-scrollbar-corner {
        background: transparent;
    }

    /* Las reglas de layout de .field y compañía ganan al `display: none` que
     el navegador aplica a [hidden], así que se refuerza aquí */
    [hidden] {
        display: none !important;
    }

    input,
    select,
    textarea {
        font-family: inherit;
    }

    /* --------------------  Piezas compartidas de UI  -------------------- */

    .panel {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1rem 1.1rem;
    }

    .panel-title {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .panel-subtitle {
        color: var(--color-text-muted);
        font-size: 0.85rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .field label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-text-muted);
    }

    .field input,
    .field select,
    .field textarea {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text);
        padding: 0.55rem 0.7rem;
        font-size: 0.92rem;
        resize: vertical;
        transition: border-color 0.15s ease;
        width: 100%;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
        outline: none;
        border-color: var(--color-primary);
    }

    .field input:disabled,
    .field select:disabled,
    .field textarea:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-primary,
    .btn-secondary,
    .btn-danger {
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.55rem 1.1rem;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease;
    }

    .btn-primary {
        background-color: var(--color-primary);
        border: 1px solid var(--color-primary);
        color: #fff;
    }

    .btn-primary:hover:not(:disabled) {
        background-color: var(--color-primary-hover);
    }

    .btn-secondary {
        background: none;
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-weight: 500;
    }

    .btn-secondary:hover:not(:disabled) {
        background-color: var(--color-surface-hover);
    }

    .btn-danger {
        background: none;
        border: 1px solid var(--color-danger);
        color: var(--color-danger);
        font-weight: 500;
    }

    .btn-danger:hover:not(:disabled) {
        background-color: var(--color-danger);
        color: #fff;
    }

    .btn-primary:disabled,
    .btn-secondary:disabled,
    .btn-danger:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .icon-btn {
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        color: var(--color-text);
        font-size: 0.85rem;
        line-height: 1;
        padding: 0.35rem 0.5rem;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease;
    }

    .icon-btn:hover {
        background-color: var(--color-surface-hover);
        border-color: var(--color-primary);
    }

    .error-text {
        color: var(--color-danger);
        font-size: 0.85rem;
    }

    .muted-text {
        color: var(--color-text-muted);
        font-size: 0.88rem;
    }

    .empty-text {
        color: var(--color-text-muted);
        text-align: center;
        padding: 1.5rem 0;
    }

    /* inline-flex + min-height: varios badges se rellenan por JS y, vacíos,
       colapsan y desplazan el contenido al llegar los datos. */
    .badge {
        display: inline-flex;
        align-items: center;
        min-height: 1.45rem;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 999px;
        color: var(--color-text-muted);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.1rem 0.55rem;
        white-space: nowrap;
    }

    .time-badge {
        background-color: color-mix(
            in srgb,
            var(--color-primary) 16%,
            transparent
        );
        border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
        color: var(--color-primary);
    }

    .app-confirm {
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background-color: var(--color-surface);
        box-shadow: var(--shadow);
        color: var(--color-text);
        max-width: min(28rem, calc(100vw - 2rem));
        padding: 0;
        width: 100%;
    }

    .app-confirm::backdrop {
        background-color: color-mix(in srgb, var(--color-bg) 55%, transparent);
    }

    .app-confirm-form {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 1.1rem 1.15rem 1rem;
    }

    .app-confirm-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
    }

    .app-confirm-message {
        color: var(--color-text-muted);
        font-size: 0.92rem;
        line-height: 1.45;
        margin: 0;
    }

    .app-confirm-actions {
        display: flex;
        gap: 0.6rem;
        justify-content: flex-end;
        margin-top: 0.25rem;
    }

    @media (max-width: 400px) {
        .panel {
            padding: 0.85rem 0.7rem;
        }

        .btn-primary,
        .btn-secondary,
        .btn-danger {
            padding: 0.5rem 0.8rem;
            font-size: 0.85rem;
        }
    }
</style>
