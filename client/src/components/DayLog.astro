---
/*
 *  -------------------------------------------------------------------  *
 *  -----  DayLog.astro  --  /client/src/components/DayLog.astro  -----  *
 *  -------------------------------------------------------------------  *
 */

// Vista de un día: listado con scroll interno, modal para agregar registros
// y transición desde el calendario (`transition:name`).

interface Props {
    /** Día a mostrar (YYYY-MM-DD). Si no se pasa, se usa hoy. */
    date?: string;
}

const { date } = Astro.props;
---

<section
    id="day-log"
    class="panel"
    data-date={date ?? ''}
    transition:name="day-log"
>
    <header class="log-header">
        <div>
            <h2 class="panel-title" data-title>Tareas del día</h2>
            <p class="panel-subtitle" data-subtitle>
                Cargando…
            </p>
        </div>

        <div class="log-header-actions">
            <span class="badge time-badge" data-total>0m</span>
            <button
                class="btn-primary"
                type="button"
                data-toggle-form
                aria-haspopup="dialog"
            >
                Agregar tarea
            </button>
        </div>
    </header>

    <div class="log-body">
        <p class="error-text" data-error role="alert" hidden></p>

        <p class="muted-text" data-no-tasks hidden>
            Todavía no hay tareas: créalas en la sección <a href="/tareas"
                >Tareas</a
            > para poder registrar tiempo.
        </p>

        <ul class="entry-list" data-list></ul>

        <p class="empty-text" data-empty hidden>
            Aún no hay nada. ¿Quieres agregar tareas…?
        </p>
    </div>

    <dialog class="entry-dialog" data-dialog aria-labelledby="entry-dialog-title">
        <form class="entry-form" data-form>
            <header class="dialog-header">
                <h3 id="entry-dialog-title" class="panel-title">
                    Agregar tarea
                </h3>
                <button
                    class="icon-btn dialog-close"
                    type="button"
                    data-cancel-form
                    aria-label="Cerrar"
                >
                    ✕
                </button>
            </header>

            <div class="field field-task">
                <label for="entry-task">Tarea</label>
                <select id="entry-task" data-task required></select>
            </div>

            <div class="field field-task">
                <label for="entry-subtask">Subtarea</label>
                <select id="entry-subtask" data-subtask></select>
            </div>

            <div class="field field-time">
                <label for="entry-start">Inicio</label>
                <input id="entry-start" type="time" data-start required />
            </div>

            <div class="field field-time">
                <label for="entry-end">Fin</label>
                <input id="entry-end" type="time" data-end required />
            </div>

            <div class="field field-note">
                <label for="entry-note">Actividad</label>
                <textarea
                    id="entry-note"
                    data-note
                    rows="5"
                    placeholder="Describe qué hiciste"
                    required
                ></textarea>
            </div>

            <p class="error-text" data-form-error role="alert" hidden></p>

            <div class="form-actions">
                <button class="btn-secondary" type="button" data-cancel-form>
                    Cancelar
                </button>
                <button class="btn-primary" type="submit" data-submit>
                    Registrar
                </button>
            </div>
        </form>
    </dialog>
</section>


<script>
    
    import { api } from '../lib/api';
    import { create, onPageReady, query, showError } from '../lib/dom';
    import { emitDataChanged, onDataChanged } from '../lib/events';
    import {
        currentTime,
        formatDateLong,
        formatMinutes,
        formatWeekday,
        todayKey,
    } from '../lib/time';
    import type { Task, TimeEntryView } from '../types/task';

    onPageReady((signal) => {
        const root = document.getElementById('day-log');
        if (!root) return;

        const titleEl = query<HTMLHeadingElement>(root, '[data-title]');
        const subtitleEl = query<HTMLParagraphElement>(root, '[data-subtitle]');
        const totalEl = query<HTMLSpanElement>(root, '[data-total]');
        const toggleFormBtn = query<HTMLButtonElement>(
            root,
            '[data-toggle-form]',
        );
        const dialog = query<HTMLDialogElement>(root, '[data-dialog]');
        const form = query<HTMLFormElement>(root, '[data-form]');
        const taskSelect = query<HTMLSelectElement>(root, '[data-task]');
        const subtaskSelect = query<HTMLSelectElement>(root, '[data-subtask]');
        const startInput = query<HTMLInputElement>(root, '[data-start]');
        const endInput = query<HTMLInputElement>(root, '[data-end]');
        const noteInput = query<HTMLTextAreaElement>(root, '[data-note]');
        const submitBtn = query<HTMLButtonElement>(root, '[data-submit]');
        const errorEl = query<HTMLParagraphElement>(root, '[data-error]');
        const formErrorEl = query<HTMLParagraphElement>(
            root,
            '[data-form-error]',
        );
        const noTasksEl = query<HTMLParagraphElement>(root, '[data-no-tasks]');
        const listEl = query<HTMLUListElement>(root, '[data-list]');
        const emptyEl = query<HTMLParagraphElement>(root, '[data-empty]');

        let currentDate = root.dataset.date || todayKey();
        let tasks: Task[] = [];

        const setDateLabel = (date: string): void => {
            titleEl.textContent = `Tareas · ${formatWeekday(date)}`;
            subtitleEl.textContent = formatDateLong(date);
        };

        const closeForm = (): void => {
            if (dialog.open) dialog.close();
            showError(formErrorEl, null);
        };

        const openForm = (): void => {
            startInput.value = startInput.value || currentTime();
            showError(formErrorEl, null);
            if (!dialog.open) dialog.showModal();
            taskSelect.focus();
        };

        const fillSubtasks = (): void => {
            const task = tasks.find((item) => item.id === taskSelect.value);
            subtaskSelect.innerHTML = '';
            subtaskSelect.appendChild(
                create('option', {
                    text: 'Sin subtarea (directo a la tarea)',
                    attrs: { value: '' },
                }),
            );
            for (const subtask of task?.subtasks.filter(
                (item) => item.active,
            ) ?? []) {
                subtaskSelect.appendChild(
                    create('option', {
                        text: subtask.title,
                        attrs: { value: subtask.id },
                    }),
                );
            }
        };

        const fillTasks = async (): Promise<void> => {
            const previous = taskSelect.value;
            tasks = (await api.getTasks()).filter((task) => task.active);

            taskSelect.innerHTML = '';
            for (const task of tasks) {
                taskSelect.appendChild(
                    create('option', {
                        text: task.title,
                        attrs: { value: task.id },
                    }),
                );
            }
            if (previous && tasks.some((task) => task.id === previous)) {
                taskSelect.value = previous;
            }
            fillSubtasks();

            const hasTasks = tasks.length > 0;
            noTasksEl.hidden = hasTasks;
            toggleFormBtn.disabled = !hasTasks;
            if (!hasTasks) closeForm();
            for (const control of [
                taskSelect,
                subtaskSelect,
                startInput,
                endInput,
                noteInput,
                submitBtn,
            ]) {
                control.disabled = !hasTasks;
            }
        };

        const renderRow = (entry: TimeEntryView): HTMLLIElement => {
            const item = create('li', { className: 'entry-item' });
            const dot = create('span', { className: 'entry-color' });
            dot.style.backgroundColor = entry.taskColor;

            const body = create('div', { className: 'entry-body' });
            const label = create('span', { className: 'entry-task' });
            label.textContent = entry.subtaskTitle
                ? `${entry.taskTitle} › ${entry.subtaskTitle}`
                : entry.taskTitle;
            body.appendChild(label);

            const crossesMidnight = entry.end <= entry.start;
            body.appendChild(
                create('span', {
                    className: 'entry-hours',
                    text: `${entry.start} → ${entry.end}${crossesMidnight ? ' (+1 día)' : ''}`,
                }),
            );
            if (entry.note) {
                body.appendChild(
                    create('span', {
                        className: 'entry-note',
                        text: entry.note,
                    }),
                );
            }

            const total = create('span', {
                className: 'badge time-badge',
                text: formatMinutes(entry.minutes),
            });

            const actions = create('div', { className: 'entry-actions' });
            const editBtn = create('button', {
                className: 'icon-btn',
                text: '✏️',
                title: 'Editar registro',
                attrs: { type: 'button' },
            });
            const deleteBtn = create('button', {
                className: 'icon-btn',
                text: '🗑️',
                title: 'Eliminar registro',
                attrs: { type: 'button' },
            });
            actions.append(editBtn, deleteBtn);

            editBtn.addEventListener(
                'click',
                () => item.replaceChildren(buildEditForm(entry)),
                { signal },
            );

            deleteBtn.addEventListener(
                'click',
                () => {
                    if (!confirm('¿Eliminar este registro de tiempo?')) return;
                    api.deleteEntry(entry.id)
                        .then(emitDataChanged)
                        .catch((error: Error) =>
                            showError(errorEl, error.message),
                        );
                },
                { signal },
            );

            item.append(dot, body, total, actions);
            return item;
        };

        const buildEditForm = (entry: TimeEntryView): HTMLFormElement => {
            const editForm = create('form', { className: 'entry-edit' });
            const start = create('input', {
                attrs: { type: 'time', value: entry.start, required: 'true' },
            });
            const end = create('input', {
                attrs: { type: 'time', value: entry.end, required: 'true' },
            });
            const note = create('textarea', {
                className: 'edit-activity',
                attrs: {
                    rows: '3',
                    placeholder: 'Actividad',
                    required: 'true',
                    'aria-label': 'Actividad',
                },
            });
            note.value = entry.note ?? '';
            const save = create('button', {
                className: 'btn-primary',
                text: 'Guardar',
                attrs: { type: 'submit' },
            });
            const cancel = create('button', {
                className: 'btn-secondary',
                text: 'Cancelar',
                attrs: { type: 'button' },
            });

            editForm.append(start, end, note, save, cancel);

            cancel.addEventListener('click', () => void loadEntries(), {
                signal,
            });
            editForm.addEventListener('submit', (event) => {
                event.preventDefault();
                api.updateEntry(entry.id, {
                    start: start.value,
                    end: end.value,
                    note: note.value,
                })
                    .then(emitDataChanged)
                    .catch((error: Error) => showError(errorEl, error.message));
            });

            return editForm;
        };

        const loadEntries = async (): Promise<void> => {
            try {
                const entries = await api.getEntries({ date: currentDate });
                listEl.replaceChildren(...entries.map(renderRow));
                const hasCatalogTasks = tasks.length > 0;
                emptyEl.hidden = entries.length > 0 || !hasCatalogTasks;
                totalEl.textContent = formatMinutes(
                    entries.reduce((total, entry) => total + entry.minutes, 0),
                );
                showError(errorEl, null);
            } catch (error) {
                showError(errorEl, (error as Error).message);
            }
        };

        taskSelect.addEventListener('change', fillSubtasks, { signal });

        toggleFormBtn.addEventListener('click', () => openForm(), { signal });

        for (const cancelBtn of root.querySelectorAll('[data-cancel-form]')) {
            cancelBtn.addEventListener(
                'click',
                () => {
                    form.reset();
                    startInput.value = currentTime();
                    fillSubtasks();
                    closeForm();
                },
                { signal },
            );
        }

        dialog.addEventListener(
            'click',
            (event) => {
                if (event.target === dialog) closeForm();
            },
            { signal },
        );

        emptyEl.addEventListener(
            'click',
            () => {
                if (!toggleFormBtn.disabled) openForm();
            },
            { signal },
        );

        form.addEventListener(
            'submit',
            (event) => {
                event.preventDefault();
                api.createEntry({
                    taskId: taskSelect.value,
                    subtaskId: subtaskSelect.value || null,
                    date: currentDate,
                    start: startInput.value,
                    end: endInput.value,
                    note: noteInput.value,
                })
                    .then(() => {
                        noteInput.value = '';
                        startInput.value = endInput.value;
                        endInput.value = '';
                        closeForm();
                        emitDataChanged();
                    })
                    .catch((error: Error) =>
                        showError(formErrorEl, error.message),
                    );
            },
            { signal },
        );

        onDataChanged(
            () => {
                void fillTasks().then(() => loadEntries());
            },
            { signal },
        );

        setDateLabel(currentDate);
        startInput.value = currentTime();
        void fillTasks()
            .then(() => loadEntries())
            .catch((error: Error) => showError(errorEl, error.message));
    });

</script>


<style>
    #day-log {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .log-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }

    .log-header-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
    }

    .log-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0.35rem 0.5rem 0.75rem 0.15rem;
    }

    .entry-dialog {
        position: fixed;
        inset: 0;
        margin: auto;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background-color: var(--color-surface);
        color: var(--color-text);
        box-shadow: var(--shadow);
        padding: 0;
        width: min(32rem, calc(100vw - 2rem));
        height: fit-content;
        max-height: min(90dvh, 40rem);
        overflow: hidden;
    }

    .entry-dialog::backdrop {
        background-color: color-mix(in srgb, #0f1117 55%, transparent);
        backdrop-filter: blur(2px);
    }

    .entry-form {
        display: grid;
        grid-template-columns: 7.5rem 7.5rem minmax(0, 1fr);
        align-items: end;
        gap: 0.7rem;
        padding: 1.15rem 1.25rem 1.25rem;
        max-height: min(90dvh, 40rem);
        overflow-y: auto;
    }

    .dialog-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.25rem;
    }

    .dialog-close {
        font-size: 0.95rem;
        line-height: 1;
    }

    /* Tarea y Subtarea ocupan cada una una fila completa (una debajo de
       otra) para que el contenido del select no quede cortado */
    .entry-form .field-task {
        grid-column: 1 / -1;
    }

    /* La Actividad ocupa su propia fila completa (textarea alto) */
    .entry-form .field-note {
        grid-column: 1 / -1;
    }

    .entry-form .form-actions,
    .entry-form [data-form-error] {
        grid-column: 1 / -1;
    }

    .entry-form .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
    }

    .entry-form select,
    .entry-form input,
    .entry-form textarea {
        width: 100%;
    }

    /* El textarea de Actividad es alto y no redimensionable */
    .entry-form textarea {
        resize: none;
        line-height: 1.45;
    }

    .entry-form button {
        height: 2.4rem;
    }

    @media (max-width: 600px) {
        .entry-form {
            grid-template-columns: 1fr 1fr;
        }

        .log-header {
            flex-direction: column;
        }

        .log-header-actions {
            width: 100%;
            justify-content: space-between;
        }
    }

    .empty-text {
        cursor: pointer;
        margin: 0.75rem 0.25rem;
        padding: 0.5rem 0.15rem;
    }

    .empty-text:hover {
        color: var(--color-text);
    }

    .entry-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin: 0.35rem 0 0;
        padding: 0 0.25rem;
    }

    .entry-list:empty {
        margin: 0;
        padding: 0;
    }

    .entry-list :global(.entry-item) {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.8rem 1rem;
    }

    .entry-list :global(.entry-color) {
        width: 8px;
        height: 32px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .entry-list :global(.entry-body) {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .entry-list :global(.entry-task) {
        font-weight: 600;
        font-size: 0.92rem;
        overflow-wrap: anywhere;
    }

    .entry-list :global(.entry-hours) {
        color: var(--color-text-muted);
        font-size: 0.8rem;
    }

    .entry-list :global(.entry-note) {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        font-style: italic;
        /* Respeta los saltos de línea escritos en el textarea */
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .entry-list :global(.entry-actions) {
        display: flex;
        gap: 0.35rem;
        flex-shrink: 0;
    }

    .entry-list :global(.entry-edit) {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
    }

    .entry-list :global(.entry-edit input),
    .entry-list :global(.entry-edit textarea) {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        color: var(--color-text);
        padding: 0.35rem 0.5rem;
        font-size: 0.85rem;
    }

    /* La Actividad en la edición: fila completa, alto y no redimensionable */
    .entry-list :global(.entry-edit textarea) {
        width: 100%;
        resize: none;
        line-height: 1.45;
    }
</style>
