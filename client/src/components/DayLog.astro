---
/*
 *  -------------------------------------------------------------------  *
 *  -----  DayLog.astro  --  /client/src/components/DayLog.astro  -----  *
 *  -------------------------------------------------------------------  *
 */

// Vista de un día: listado con scroll interno y modal para agregar registros.
// `transition:persist` mantiene el panel entre /dia/A → /dia/B (sin morph ni
// salto). La fecha se lee de la URL en cada `astro:page-load`.

interface Props {
    /** Día a mostrar (YYYY-MM-DD). Si no se pasa, se usa hoy. */
    date?: string;
}

const { date } = Astro.props;
---

<section
    id="day-log"
    class="panel"
    data-date={date ?? ''}
    transition:persist="day-log"
>
    <header class="log-header">
        <div>
            <h2 class="panel-title" data-title>Tareas del día</h2>
            <p class="panel-subtitle" data-subtitle>
                Cargando…
            </p>
        </div>

        <div class="log-header-actions">
            <span class="badge time-badge" data-total>0m</span>
            <button
                class="btn-primary"
                type="button"
                data-toggle-form
                aria-haspopup="dialog"
                aria-expanded="false"
            >
                Agregar tarea
            </button>
        </div>
    </header>

    <div class="log-body">
        <p class="error-text" data-error role="alert" hidden></p>

        <p class="muted-text" data-no-tasks hidden>
            Todavía no hay tareas: créalas en la sección <a href="/tareas"
                >Tareas</a
            > para poder registrar tiempo.
        </p>

        <ul class="entry-list" data-list></ul>

        <button class="empty-text" type="button" data-empty hidden>
            Aún no hay nada. ¿Quieres agregar tareas…?
        </button>
    </div>

    <dialog class="entry-dialog" data-dialog aria-labelledby="entry-dialog-title">
        <form class="entry-form" data-form>
            <header class="dialog-header">
                <h3 id="entry-dialog-title" class="panel-title">
                    Agregar tarea
                </h3>
                <button
                    class="icon-btn dialog-close"
                    type="button"
                    data-cancel-form
                    aria-label="Cerrar"
                >
                    ✕
                </button>
            </header>

            <div class="field field-task">
                <label for="entry-task">Tarea</label>
                <select id="entry-task" data-task required></select>
            </div>

            <div class="field field-task">
                <label for="entry-subtask">Subtarea</label>
                <select id="entry-subtask" data-subtask></select>
            </div>

            <div class="field field-time">
                <label for="entry-start">Inicio</label>
                <input id="entry-start" type="time" data-start required />
            </div>

            <div class="field field-time">
                <label for="entry-end">Fin</label>
                <input id="entry-end" type="time" data-end required />
            </div>

            <div class="field field-note">
                <label for="entry-note">Actividad</label>
                <textarea
                    id="entry-note"
                    data-note
                    rows="5"
                    placeholder="Describe qué hiciste"
                    required
                ></textarea>
            </div>

            <p class="error-text" data-form-error role="alert" hidden></p>

            <div class="form-actions">
                <button class="btn-secondary" type="button" data-cancel-form>
                    Cancelar
                </button>
                <button class="btn-primary" type="submit" data-submit>
                    Registrar
                </button>
            </div>
        </form>
    </dialog>
</section>


<script>
    import { api } from '../lib/api';
    import { create, onPageReady, query, showConfirm, showError } from '../lib/dom';
    import { emitDataChanged, onDataChanged } from '../lib/events';
    import {
        currentTime,
        formatDateLong,
        formatMinutes,
        formatWeekday,
        todayKey,
    } from '../lib/time';
    import type { Task, TimeEntryView } from '../../types/types';

    /**
     * ---------------------------------
     * -----  `dateFromUrl()`  -----
     * ---------------------------------
     * - Extrae la fecha actual desde la URL de la vista diaria.
     */
    const dateFromUrl = (): string | null => {
        const match = window.location.pathname.match(
            /^\/dia\/(\d{4}-\d{2}-\d{2})\/?$/,
        );
        return match?.[1] ?? null;
    };

    onPageReady((signal) => {
        /*
            *  ---------------------------------  *
            *  -----  Referencias al HTML  -----  *
            *  ---------------------------------  *
        */

        // - `Panel raíz del registro diario`
        const root = document.getElementById('day-log') as HTMLElement | null;
        if (!root) return;

        // - `Título principal del día`
        const titleEl = query<HTMLHeadingElement>(root, '[data-title]');

        // - `Subtítulo con la fecha larga`
        const subtitleEl = query<HTMLParagraphElement>(root, '[data-subtitle]');

        // - `Indicador del total acumulado del día`
        const totalEl = query<HTMLSpanElement>(root, '[data-total]');

        // - `Botón para abrir el formulario de registro`
        const toggleFormBtn = query<HTMLButtonElement>(
            root,
            '[data-toggle-form]',
        );

        // - `Diálogo modal del formulario`
        const dialog = query<HTMLDialogElement>(root, '[data-dialog]');

        // - `Formulario para crear un registro`
        const form = query<HTMLFormElement>(root, '[data-form]');

        // - `Selector de tarea`
        const taskSelect = query<HTMLSelectElement>(root, '[data-task]');

        // - `Selector de subtarea`
        const subtaskSelect = query<HTMLSelectElement>(root, '[data-subtask]');

        // - `Campo de hora de inicio`
        const startInput = query<HTMLInputElement>(root, '[data-start]');

        // - `Campo de hora de fin`
        const endInput = query<HTMLInputElement>(root, '[data-end]');

        // - `Campo de nota o actividad`
        const noteInput = query<HTMLTextAreaElement>(root, '[data-note]');

        // - `Botón de envío del formulario`
        const submitBtn = query<HTMLButtonElement>(root, '[data-submit]');

        // - `Mensaje de error del listado`
        const errorEl = query<HTMLParagraphElement>(root, '[data-error]');

        // - `Mensaje de error del formulario`
        const formErrorEl = query<HTMLParagraphElement>(
            root,
            '[data-form-error]',
        );

        // - `Mensaje cuando aún no existen tareas`
        const noTasksEl = query<HTMLParagraphElement>(root, '[data-no-tasks]');

        // - `Listado de registros del día`
        const listEl = query<HTMLUListElement>(root, '[data-list]');

        // - `Estado vacío del día`
        const emptyEl = query<HTMLButtonElement>(root, '[data-empty]');

        // Con persist el DOM no se regenera: la fecha nueva viene de la URL.
        let currentDate = dateFromUrl() || root.dataset.date || todayKey();
        root.dataset.date = currentDate;
        let tasks: Task[] = [];

        /**
         * ---------------------------------
         * -----  `setDateLabel(date)`  -----
         * ---------------------------------
         * - Actualiza la cabecera textual con la fecha seleccionada.
         */
        const setDateLabel = (date: string): void => {
            titleEl.textContent = `Tareas · ${formatWeekday(date)}`;
            subtitleEl.textContent = formatDateLong(date);
        };

        /**
         * -------------------------------
         * -----  `closeForm()`  -----
         * -------------------------------
         * - Cierra el modal y limpia el error del formulario.
         */
        const closeForm = (): void => {
            if (dialog.open) dialog.close();
            showError(formErrorEl, null);
        };

        /**
         * ------------------------------
         * -----  `openForm()`  -----
         * ------------------------------
         * - Prepara y abre el modal para registrar una actividad.
         */
        const openForm = (): void => {
            startInput.value = startInput.value || currentTime();
            showError(formErrorEl, null);
            if (!dialog.open) dialog.showModal();
            toggleFormBtn.setAttribute('aria-expanded', 'true');
            taskSelect.focus();
        };

        //  -----  sincronizar el estado del diálogo con el botón de apertura  -----
        dialog.addEventListener(
            'close',
            () => toggleFormBtn.setAttribute('aria-expanded', 'false'),
            { signal },
        );

        /**
         * ----------------------------------
         * -----  `fillSubtasks()`  -----
         * ----------------------------------
         * - Rellena el selector de subtareas según la tarea elegida.
         */
        const fillSubtasks = (): void => {
            const task = tasks.find((item) => item.id === taskSelect.value);
            subtaskSelect.replaceChildren(
                create('option', {
                    text: 'Sin subtarea (directo a la tarea)',
                    attrs: { value: '' },
                }),
            );
            for (const subtask of task?.subtasks.filter((item) => item.active) ?? []) {
                subtaskSelect.appendChild(
                    create('option', {
                        text: subtask.title,
                        attrs: { value: subtask.id },
                    }),
                );
            }
        };

        /**
         * -------------------------------
         * -----  `fillTasks()`  -----
         * -------------------------------
         * - Carga las tareas activas y sincroniza el estado del formulario.
         */
        const fillTasks = async (): Promise<void> => {
            const previous = taskSelect.value;
            tasks = (await api.getTasks()).filter((task) => task.active);

            taskSelect.replaceChildren();
            for (const task of tasks) {
                taskSelect.appendChild(
                    create('option', {
                        text: task.title,
                        attrs: { value: task.id },
                    }),
                );
            }
            if (previous && tasks.some((task) => task.id === previous)) {
                taskSelect.value = previous;
            }
            fillSubtasks();

            const hasTasks = tasks.length > 0;
            noTasksEl.hidden = hasTasks;
            toggleFormBtn.disabled = !hasTasks;

            //  -----  si no hay tareas activas, cerrar el formulario  -----
            if (!hasTasks) closeForm();

            for (const control of [
                taskSelect,
                subtaskSelect,
                startInput,
                endInput,
                noteInput,
                submitBtn,
            ]) {
                control.disabled = !hasTasks;
            }
        };

        /**
         * -----------------------------------
         * -----  `indentLevel(leading)`  -----
         * -----------------------------------
         * - Calcula el nivel de sangría según espacios y tabulaciones.
         */
        const indentLevel = (leading: string): number => {
            let level = 0;
            for (const char of leading) {
                level += char === '\t' ? 1 : 0.5;
            }
            return Math.floor(level);
        };

        /**
         * ----------------------------------------
         * -----  `renderNoteOutline(note)`  -----
         * ----------------------------------------
         * - Convierte la actividad escrita en una lista jerárquica visual.
         */
        const renderNoteOutline = (note: string): HTMLUListElement | null => {
            const parsed = note
                .split('\n')
                .map((raw) => {
                    const match = raw.match(/^(\s*)(.*)$/);
                    const leading = match?.[1] ?? '';
                    let content = (match?.[2] ?? '').trimEnd();
                    if (!content.trim()) return null;
                    const bullet = content.match(/^[-•]\s*(.*)$/);
                    const hadBullet = Boolean(bullet);
                    if (bullet) content = bullet[1] ?? '';
                    return {
                        level: indentLevel(leading),
                        hadBullet,
                        content: content.trim(),
                    };
                })
                .filter((line): line is NonNullable<typeof line> =>
                    Boolean(line?.content),
                );

            //  -----  si no hay líneas útiles, no renderizar la lista  -----
            if (parsed.length === 0) return null;

            const firstIsPlain = !parsed[0].hadBullet;
            const list = create('ul', { className: 'outline-note' });

            for (const line of parsed) {
                let level = line.level;

                //  -----  si la primera línea es plana, desplazar las viñetas hijas  -----
                if (line.hadBullet && firstIsPlain) level += 1;

                const item = create('li', {
                    className: 'outline-line',
                    text: line.content,
                });
                item.style.setProperty('--outline-level', String(level));
                list.appendChild(item);
            }

            return list;
        };

        /**
         * -----------------------------------
         * -----  `renderEntry(entry)`  -----
         * -----------------------------------
         * - Crea el bloque visual de un registro de tiempo.
         */
        const renderEntry = (entry: TimeEntryView): HTMLElement => {
            const block = create('article', { className: 'entry-block' });
            const crossesMidnight = entry.end < entry.start;

            const timeRow = create('div', { className: 'entry-time-row' });
            timeRow.appendChild(
                create('span', {
                    className: 'entry-hours',
                    text: `${entry.start} - ${entry.end}${crossesMidnight ? ' (+1 día)' : ''}`,
                }),
            );
            timeRow.appendChild(
                create('span', {
                    className: 'badge time-badge entry-duration',
                    text: formatMinutes(entry.minutes),
                }),
            );

            const outline = create('div', { className: 'entry-outline' });

            //  -----  si el registro pertenece a una subtarea, mostrar su nombre  -----
            if (entry.subtaskTitle) {
                outline.appendChild(
                    create('div', {
                        className: 'outline-subtask',
                        text: entry.subtaskTitle,
                    }),
                );
            }

            //  -----  si hay nota, pintarla como esquema jerárquico  -----
            if (entry.note) {
                const noteList = renderNoteOutline(entry.note);
                if (noteList) outline.appendChild(noteList);
            }

            const actions = create('div', { className: 'entry-actions' });
            const editBtn = create('button', {
                className: 'icon-btn',
                text: '✏️',
                title: 'Editar registro',
                attrs: { type: 'button', 'aria-label': 'Editar registro' },
            });
            const deleteBtn = create('button', {
                className: 'icon-btn',
                text: '🗑️',
                title: 'Eliminar registro',
                attrs: { type: 'button', 'aria-label': 'Eliminar registro' },
            });
            actions.append(editBtn, deleteBtn);

            editBtn.addEventListener(
                'click',
                () => block.replaceChildren(buildEditForm(entry)),
                { signal },
            );

            deleteBtn.addEventListener(
                'click',
                () => {
                    void showConfirm({
                        title: 'Eliminar registro',
                        message: '¿Eliminar este registro de tiempo?',
                        confirmText: 'Eliminar',
                        danger: true,
                    }).then((confirmed) => {
                        //  -----  si se cancela la confirmación, no borrar el registro  -----
                        if (!confirmed) return;

                        api.deleteEntry(entry.id)
                            .then(emitDataChanged)
                            .catch((error: Error) =>
                                showError(errorEl, error.message),
                            );
                    });
                },
                { signal },
            );

            block.append(timeRow, outline, actions);
            return block;
        };

        /**
         * ----------------------------------
         * -----  `renderDay(entries)`  -----
         * ----------------------------------
         * - Agrupa y pinta los registros del día por tarea.
         */
        const renderDay = (entries: TimeEntryView[]): DocumentFragment => {
            const fragment = document.createDocumentFragment();
            const groups = new Map<
                string,
                {
                    taskTitle: string;
                    taskColor: string;
                    entries: TimeEntryView[];
                }
            >();

            for (const entry of entries) {
                const existing = groups.get(entry.taskId);

                //  -----  si la tarea ya tiene grupo, añadir el registro  -----
                if (existing) {
                    existing.entries.push(entry);
                }
                //  -----  si la tarea aún no tiene grupo, crearlo  -----
                else {
                    groups.set(entry.taskId, {
                        taskTitle: entry.taskTitle,
                        taskColor: entry.taskColor,
                        entries: [entry],
                    });
                }
            }

            for (const group of groups.values()) {
                const item = create('li', { className: 'task-group' });
                item.style.setProperty('--task-color', group.taskColor);

                item.appendChild(
                    create('h3', {
                        className: 'task-heading',
                        text: group.taskTitle,
                    }),
                );

                for (const entry of group.entries) {
                    item.appendChild(renderEntry(entry));
                }

                fragment.appendChild(item);
            }

            return fragment;
        };

        /**
         * --------------------------------------
         * -----  `buildEditForm(entry)`  -----
         * --------------------------------------
         * - Construye el formulario inline para editar un registro.
         */
        const buildEditForm = (entry: TimeEntryView): HTMLFormElement => {
            const editForm = create('form', { className: 'entry-edit' });
            const start = create('input', {
                attrs: { type: 'time', value: entry.start, required: 'true' },
            });
            const end = create('input', {
                attrs: { type: 'time', value: entry.end, required: 'true' },
            });
            const note = create('textarea', {
                className: 'edit-activity',
                attrs: {
                    rows: '3',
                    placeholder: 'Actividad',
                    required: 'true',
                    'aria-label': 'Actividad',
                },
            });
            note.value = entry.note ?? '';
            const save = create('button', {
                className: 'btn-primary',
                text: 'Guardar',
                attrs: { type: 'submit' },
            });
            const cancel = create('button', {
                className: 'btn-secondary',
                text: 'Cancelar',
                attrs: { type: 'button' },
            });

            editForm.append(start, end, note, save, cancel);

            cancel.addEventListener('click', () => void loadEntries(), {
                signal,
            });
            editForm.addEventListener('submit', (event: SubmitEvent) => {
                event.preventDefault();
                api.updateEntry(entry.id, {
                    start: start.value,
                    end: end.value,
                    note: note.value,
                })
                    .then(emitDataChanged)
                    .catch((error: Error) => showError(errorEl, error.message));
            });

            return editForm;
        };

        /**
         * --------------------------------
         * -----  `loadEntries()`  -----
         * --------------------------------
         * - Carga y pinta los registros de la fecha actual.
         */
        const loadEntries = async (): Promise<void> => {
            try {
                const entries = await api.getEntries({ date: currentDate });
                listEl.replaceChildren(renderDay(entries));
                const hasCatalogTasks = tasks.length > 0;
                emptyEl.hidden = entries.length > 0 || !hasCatalogTasks;
                totalEl.textContent = formatMinutes(
                    entries.reduce((total, entry) => total + entry.minutes, 0),
                );
                showError(errorEl, null);
            }
            //  -----  si la carga falla, mostrar el error  -----
            catch (error) {
                showError(errorEl, (error as Error).message);
            }
        };

        taskSelect.addEventListener('change', fillSubtasks, { signal });
        toggleFormBtn.addEventListener('click', () => openForm(), { signal });

        for (const cancelBtn of root.querySelectorAll('[data-cancel-form]')) {
            cancelBtn.addEventListener(
                'click',
                () => {
                    form.reset();
                    startInput.value = currentTime();
                    fillSubtasks();
                    closeForm();
                },
                { signal },
            );
        }

        dialog.addEventListener(
            'click',
            (event: MouseEvent) => {
                if (event.target === dialog) closeForm();
            },
            { signal },
        );

        emptyEl.addEventListener(
            'click',
            () => {
                //  -----  si el botón está disponible, abrir el formulario  -----
                if (!toggleFormBtn.disabled) openForm();
            },
            { signal },
        );

        form.addEventListener(
            'submit',
            (event: SubmitEvent) => {
                event.preventDefault();
                api.createEntry({
                    taskId: taskSelect.value,
                    subtaskId: subtaskSelect.value || null,
                    date: currentDate,
                    start: startInput.value,
                    end: endInput.value,
                    note: noteInput.value,
                })
                    .then(() => {
                        noteInput.value = '';
                        startInput.value = endInput.value;
                        endInput.value = '';
                        closeForm();
                        emitDataChanged();
                    })
                    .catch((error: Error) =>
                        showError(formErrorEl, error.message),
                    );
            },
            { signal },
        );

        onDataChanged(
            () => {
                void fillTasks().then(() => loadEntries());
            },
            { signal },
        );

        // No vaciar la lista aquí: colapsar → rellenar provoca salto de altura
        // en móvil. loadEntries sustituye el contenido cuando llegan los datos.
        closeForm();
        showError(errorEl, null);
        setDateLabel(currentDate);
        startInput.value = currentTime();
        void fillTasks()
            .then(() => loadEntries())
            .catch((error: Error) => showError(errorEl, error.message));
    });
</script>


<style>
    #day-log {
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        align-self: stretch;
        width: 100%;
        height: 100%;
        min-height: 0;
        max-height: 100%;
        overflow: hidden;
        box-sizing: border-box;
    }

    .log-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }

    .log-header-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
    }

    .log-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 0.35rem 0.5rem 0.75rem 0.15rem;
    }

    .entry-dialog {
        position: fixed;
        inset: 0;
        margin: auto;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background-color: var(--color-surface);
        color: var(--color-text);
        box-shadow: var(--shadow);
        padding: 0;
        width: min(32rem, calc(100vw - 2rem));
        height: fit-content;
        max-height: min(90dvh, 40rem);
        overflow: hidden;
    }

    .entry-dialog::backdrop {
        background-color: color-mix(in srgb, #0f1117 55%, transparent);
        backdrop-filter: blur(2px);
    }

    .entry-form {
        display: grid;
        grid-template-columns: 7.5rem 7.5rem minmax(0, 1fr);
        align-items: end;
        gap: 0.7rem;
        padding: 1.15rem 1.25rem 1.25rem;
        max-height: min(90dvh, 40rem);
        overflow-y: auto;
    }

    .dialog-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.25rem;
    }

    .dialog-close {
        font-size: 0.95rem;
        line-height: 1;
    }

    /* Tarea y Subtarea ocupan cada una una fila completa (una debajo de
       otra) para que el contenido del select no quede cortado */
    .entry-form .field-task {
        grid-column: 1 / -1;
    }

    /* La Actividad ocupa su propia fila completa (textarea alto) */
    .entry-form .field-note {
        grid-column: 1 / -1;
    }

    .entry-form .form-actions,
    .entry-form [data-form-error] {
        grid-column: 1 / -1;
    }

    .entry-form .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
    }

    .entry-form select,
    .entry-form input,
    .entry-form textarea {
        width: 100%;
    }

    /* El textarea de Actividad es alto y no redimensionable */
    .entry-form textarea {
        resize: none;
        line-height: 1.45;
    }

    .entry-form button {
        height: 2.4rem;
    }

    @media (max-width: 600px) {
        .entry-form {
            grid-template-columns: 1fr 1fr;
        }

        .log-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .log-header-actions {
            width: 100%;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
        }

        .log-header-actions .btn-primary {
            flex: 1;
            justify-content: center;
        }
    }

    .empty-text {
        display: block;
        width: 100%;
        cursor: pointer;
        margin: 0.35rem 0 0;
        padding: 1rem 0.85rem;
        text-align: center;
        color: var(--color-text-muted);
        font-family: inherit;
        font-size: 0.9rem;
        line-height: 1.45;
        border: 1px dashed var(--color-border);
        border-radius: 8px;
        background-color: color-mix(
            in srgb,
            var(--color-surface-hover) 45%,
            transparent
        );
    }

    .empty-text:hover {
        color: var(--color-text);
        border-color: var(--color-primary);
    }

    .entry-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin: 0.75rem auto 0;
        padding: 0 0.5rem 0.5rem;
        max-width: 42rem;
        width: 100%;
    }

    .entry-list:empty {
        margin: 0;
        padding: 0;
    }

    .entry-list :global(.task-heading) {
        margin: 0;
        text-align: center;
        font-size: 0.98rem;
        font-weight: 700;
