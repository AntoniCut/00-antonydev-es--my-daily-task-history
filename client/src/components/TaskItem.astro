---
// Plantilla de una tarea individual. Su contenido se clona en el cliente
// desde TaskList para renderizar cada tarea del día seleccionado.
---

<template id="task-item-template">
  <li class="task-item">
    <input type="checkbox" class="task-checkbox" aria-label="Marcar como completada" />
    <div class="task-body">
      <span class="task-title"></span>
      <p class="task-description"></p>
    </div>
    <div class="task-actions">
      <button type="button" class="btn-edit" title="Editar tarea">✏️</button>
      <button type="button" class="btn-delete" title="Eliminar tarea">🗑️</button>
    </div>
  </li>
</template>

<style>
  .task-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    transition: border-color 0.15s ease;
  }

  .task-item:hover {
    border-color: var(--color-primary);
  }

  .task-checkbox {
    margin-top: 0.3rem;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-success);
    cursor: pointer;
    flex-shrink: 0;
  }

  .task-body {
    flex: 1;
    min-width: 0;
  }

  .task-title {
    font-weight: 600;
    display: block;
    overflow-wrap: break-word;
  }

  .task-item.is-completed .task-title {
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  .task-description {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin-top: 0.2rem;
    overflow-wrap: break-word;
    white-space: pre-line;
  }

  .task-description:empty {
    display: none;
  }

  .task-actions {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .btn-edit,
  .btn-delete {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.9rem;
    padding: 0.3rem 0.5rem;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .btn-edit:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .btn-delete:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-danger);
  }
</style>
