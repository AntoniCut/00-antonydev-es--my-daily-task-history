<style is:global>
    /*
      View transition del calendario (`transition:name="calendar"`).
      Sin width/height 100% + object-fit en old/new, el UA usa block-size:auto
      y el morph (compact → large) se estira de más; al terminar salta al
      tamaño real. overflow:clip mantiene el par dentro del group.
    */
    ::view-transition-group(calendar) {
        animation-duration: 300ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        /* Viaja por encima del listado de tareas al regresar al aside. */
        z-index: 1000;
        overflow: clip;
    }

    ::view-transition-image-pair(calendar) {
        isolation: isolate;
    }

    ::view-transition-old(calendar),
    ::view-transition-new(calendar) {
        animation-duration: 300ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        width: 100%;
        height: 100%;
        object-fit: cover;
        overflow: clip;
    }
</style>
