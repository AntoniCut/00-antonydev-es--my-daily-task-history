---
/*
 *  -----------------------------------------------------------------------  *
 *  -----  Calendar.astro  --  /client/src/components/Calendar.astro  -----  *
 *  -----------------------------------------------------------------------  *
 */

// Calendario mensual: en el dashboard ocupa todo el ancho (large). En la
// vista de un día aparece compacto en el sidebar (flotante en desktop;
// acoplado bajo el menú en pantallas ≤900px).
// Ambas variantes comparten el mismo `transition:name` para que el panel
// "vuele" de una posición/tamaño a otro (morph).

interface Props {
    /** `large` = dashboard; `compact` = sidebar en vista de un día */
    variant?: 'large' | 'compact';
    /** Día resaltado (YYYY-MM-DD). En compact suele venir de la URL. */
    selectedDate?: string;
}

const { variant = 'large', selectedDate } = Astro.props;
const transitionName = 'calendar';
---

<div
    id="calendar"
    class:list={['calendar', 'panel', `calendar--${variant}`]}
    data-variant={variant}
    data-selected={selectedDate ?? ''}
    transition:name={transitionName}
>
    <div class="calendar-header" data-drag-handle>
        {
            variant === 'compact' && (
                <span
                    class="calendar-drag-grip"
                    aria-hidden="true"
                    title="Arrastra el calendario"
                >
                    ⋮⋮
                </span>
            )
        }
        <button
            class="nav-btn"
            type="button"
            data-prev
            aria-label="Mes anterior">‹</button
        >

        <h2 class="panel-title" data-title></h2>

        <button
            class="nav-btn"
            type="button"
            data-next
            aria-label="Mes siguiente">›</button
        >
    </div>

    <div class="calendar-weekdays">
        <span>Lun</span>
        <span>Mar</span>
        <span>Mié</span>
        <span>Jue</span>
        <span>Vie</span>
        <span>Sáb</span>
        <span>Dom</span>
    </div>

    <div class="calendar-grid" role="grid" data-grid></div>

    <footer class="calendar-footer">
        <p class="muted-text" data-month-total></p>

        <div class="calendar-footer-actions">
            {
                variant === 'compact' && (
                    <a class="btn-secondary calendar-month-link" href="/">
                        Mes completo
                    </a>
                )
            }
            <button class="btn-secondary" type="button" data-today>Hoy</button>
        </div>
    </footer>
</div>

<script>
    import { navigate } from 'astro:transitions/client';
    import { api } from '../lib/api';
    import { create, onPageReady, query } from '../lib/dom';
    import { dockFixed, makeDraggable } from '../lib/draggable';
    import { onDataChanged } from '../lib/events';
    import {
        MONTH_NAMES,
        formatMinutes,
        monthRange,
        todayKey,
    } from '../lib/time';

    interface DayTask {
        id: string;
        title: string;
        color: string;
    }

    interface DayInfo {
        minutes: number;
        tasks: DayTask[];
    }

    const MAX_TASK_CHIPS = 3;

    /**
     * El `calendar-compact` en desktop es flotante y arrastrable; arranca
     * `visibility: hidden` hasta que el script (en `astro:page-load`) lo ancla
     * con `dockFixed`. Como el navegador toma el snapshot del nuevo DOM ANTES
     * de que ese script corra, el `::view-transition-new(calendar)` sale
     * invisible y el navegador recorta el morph (de ahí el "va rápido" al
     * regresar del dashboard al día).
     *
     * Lo resolvemos anclando el compacto del documento entrante a su posición
     * guardada en `astro:before-swap` (antes del snapshot), replicando la
     * lógica de `dockFixed`. `event.newDocument` es el documento destino:
     * parchearlo aquí persiste tras el swap.
     */
    const COMPACT_STORAGE_KEY = 'calendar-compact-position';
    let preSwapBound = false;

    const preAnchorCompact = (doc: Document): void => {
        if (window.matchMedia('(max-width: 900px)').matches) return;

        const cal = doc.getElementById('calendar');
        if (!(cal instanceof HTMLElement) || cal.dataset.variant !== 'compact') {
            return;
        }

        let x = 0;
        let y = 0;
        try {
            const raw = localStorage.getItem(COMPACT_STORAGE_KEY);
            if (raw) {
                const parsed = JSON.parse(raw) as { x?: unknown; y?: unknown };
                if (typeof parsed.x === 'number') x = parsed.x;
                if (typeof parsed.y === 'number') y = parsed.y;
            }
        } catch {
            /* ignore */
        }

        // posición por defecto: margen inferior-derecho del sidebar izquierdo
        if (!x && !y) {
            x = 300;
            y = 80;
        }

        const maxX = Math.max(0, window.innerWidth - cal.offsetWidth);
        const maxY = Math.max(0, window.innerHeight - cal.offsetHeight);
        x = Math.min(Math.max(x, 0), maxX);
        y = Math.min(Math.max(y, 0), maxY);

        cal.classList.add('is-floating');
        cal.classList.remove('is-docked');
        cal.style.position = 'fixed';
        cal.style.left = `${x}px`;
        cal.style.top = `${y}px`;
        cal.style.right = 'auto';
        cal.style.bottom = 'auto';
        cal.style.margin = '0';
        cal.style.zIndex = '50';
        cal.style.visibility = 'visible';
    };

    if (!preSwapBound) {
        preSwapBound = true;
        document.addEventListener('astro:before-swap', (event: Event) => {
            const doc = (event as Event & {
                newDocument?: Document;
            }).newDocument;
            if (doc) preAnchorCompact(doc);
        });
    }

    onPageReady((signal) => {
        const root = document.getElementById('calendar');
        if (!root) return;

        const variant = root.dataset.variant === 'compact' ? 'compact' : 'large';
        const titleEl = query<HTMLHeadingElement>(root, '[data-title]');
        const gridEl = query<HTMLDivElement>(root, '[data-grid]');
        const totalEl = query<HTMLParagraphElement>(root, '[data-month-total]');
        const prevBtn = query<HTMLButtonElement>(root, '[data-prev]');
        const nextBtn = query<HTMLButtonElement>(root, '[data-next]');
        const todayBtn = query<HTMLButtonElement>(root, '[data-today]');

        const today = todayKey();
        const pad = (value: number) => String(value).padStart(2, '0');

        const initialSelected = root.dataset.selected || today;
        let [viewYear, viewMonth] = [
            Number(initialSelected.slice(0, 4)),
            Number(initialSelected.slice(5, 7)) - 1,
        ];
        let selectedDate = initialSelected;
        let daysByDate = new Map<string, DayInfo>();

        const goToDay = (dateKey: string): void => {
            selectedDate = dateKey;
            void navigate(`/dia/${dateKey}`);
        };

        const loadMonth = async (): Promise<void> => {
            const monthKey = `${viewYear}-${pad(viewMonth + 1)}-01`;
            const { from, to } = monthRange(monthKey);
            try {
                const entries = await api.getEntries({ from, to });
                const next = new Map<string, DayInfo>();

                for (const entry of entries) {
                    let day = next.get(entry.date);
                    if (!day) {
                        day = { minutes: 0, tasks: [] };
                        next.set(entry.date, day);
                    }
                    day.minutes += entry.minutes;
                    if (!day.tasks.some((task) => task.id === entry.taskId)) {
                        day.tasks.push({
                            id: entry.taskId,
                            title: entry.taskTitle,
                            color: entry.taskColor,
                        });
                    }
                }

                daysByDate = next;
            } catch {
                daysByDate = new Map();
            }
        };

        const renderTaskChips = (
            cell: HTMLButtonElement,
            tasks: DayTask[],
        ): void => {
            if (variant !== 'large' || tasks.length === 0) return;

            const list = create('div', { className: 'day-tasks' });
            for (const task of tasks.slice(0, MAX_TASK_CHIPS)) {
                const chip = create('span', {
                    className: 'day-task',
                    text: task.title,
                    title: task.title,
                });
                chip.style.setProperty('--task-color', task.color);
                list.appendChild(chip);
            }
            if (tasks.length > MAX_TASK_CHIPS) {
                list.appendChild(
                    create('span', {
                        className: 'day-task-more',
                        text: `+${tasks.length - MAX_TASK_CHIPS}`,
                    }),
                );
            }
            cell.appendChild(list);
        };

        const renderDots = (
            cell: HTMLButtonElement,
            tasks: DayTask[],
        ): void => {
            if (variant !== 'compact' || tasks.length === 0) return;

            const dots = create('div', { className: 'day-dots' });
            for (const task of tasks.slice(0, 4)) {
                const dot = create('span', { className: 'day-dot' });
                dot.style.backgroundColor = task.color;
                dots.appendChild(dot);
            }
            cell.appendChild(dots);
        };

        const render = (): void => {
            titleEl.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
            gridEl.innerHTML = '';

            const firstWeekday =
                (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

            for (let i = 0; i < firstWeekday; i++) {
                gridEl.appendChild(create('span', { className: 'day-empty' }));
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dateKey = `${viewYear}-${pad(viewMonth + 1)}-${pad(day)}`;
                const info = daysByDate.get(dateKey);
                const minutes = info?.minutes ?? 0;
                const tasks = info?.tasks ?? [];

                const cell = create('button', {
                    className: 'day-cell',
                    attrs: { type: 'button', 'aria-label': dateKey },
                });
                if (dateKey === today) cell.classList.add('is-today');
                if (dateKey === selectedDate) cell.classList.add('is-selected');
                if (minutes) cell.classList.add('has-time');

                cell.appendChild(
                    create('span', {
                        className: 'day-number',
                        text: String(day),
                    }),
                );

                renderTaskChips(cell, tasks);
                renderDots(cell, tasks);

                cell.appendChild(
                    create('span', {
                        className: 'day-time',
                        text: minutes ? formatMinutes(minutes) : '',
                    }),
                );

                cell.addEventListener('click', () => goToDay(dateKey), {
                    signal,
                });
                gridEl.appendChild(cell);
            }

            const monthMinutes = [...daysByDate.values()].reduce(
                (total, day) => total + day.minutes,
                0,
            );
            totalEl.textContent = `Total del mes: ${formatMinutes(monthMinutes)}`;
        };

        const refresh = async (): Promise<void> => {
            await loadMonth();
            render();
        };

        const moveMonth = (offset: number): void => {
            const date = new Date(viewYear, viewMonth + offset, 1);
            viewYear = date.getFullYear();
            viewMonth = date.getMonth();
            void refresh();
        };

        prevBtn.addEventListener('click', () => moveMonth(-1), { signal });
        nextBtn.addEventListener('click', () => moveMonth(1), { signal });

        todayBtn.addEventListener(
            'click',
            () => {
                viewYear = Number(today.slice(0, 4));
                viewMonth = Number(today.slice(5, 7)) - 1;
                void refresh().then(() => goToDay(today));
            },
            { signal },
        );

        onDataChanged(() => void refresh(), { signal });

        if (variant === 'compact') {
            const host = document.getElementById('sidebar-calendar-host');
            const storageKey = 'calendar-compact-position';
            const mobileQuery = window.matchMedia('(max-width: 900px)');
            let dragCleanup: (() => void) | null = null;

            const clearFloating = (): void => {
                dragCleanup?.();
                dragCleanup = null;
                root.removeAttribute('style');
                root.classList.remove('is-draggable', 'is-dragging', 'is-floating');
                root.classList.add('is-docked');
                host?.classList.add('is-calendar-docked');
            };

            const enableFloating = (): void => {
                root.classList.remove('is-docked');
                host?.classList.remove('is-calendar-docked');

                // Anclar antes de hacerlo visible (clase is-floating).
                if (host) dockFixed(root, host, storageKey);
                root.classList.add('is-floating');

                if (!dragCleanup) {
                    dragCleanup = makeDraggable(root, {
                        handle: '[data-drag-handle]',
                        storageKey,
                        signal,
                    });
                }
            };

            const syncLayout = (): void => {
                if (mobileQuery.matches) {
                    // Pantallas pequeñas: calendario en flujo, bajo el menú
                    clearFloating();
                } else {
                    enableFloating();
                }
            };

            // Layout ya (evita frame con position:absolute / 320px).
            syncLayout();
            mobileQuery.addEventListener('change', syncLayout, { signal });
            window.addEventListener(
                'resize',
                () => {
                    if (!mobileQuery.matches && host) {
                        dockFixed(root, host, storageKey);
                    }
                },
                { signal },
            );
        } else {
            // Quitar restos del modo flotante (fixed / tamaño) al volver al dashboard
            root.removeAttribute('style');
            root.classList.remove(
                'is-draggable',
                'is-dragging',
                'is-floating',
                'is-docked',
            );
        }

        // Pintar la rejilla al momento (sin datos) para fijar altura; luego
        // refresh solo añade puntos/tiempos sin cambiar el tamaño del mes.
        render();
        void refresh();
    });
</script>

<style>
    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.35rem;
        margin-bottom: 1rem;
    }

    .calendar-header .panel-title {
        flex: 1;
        text-align: center;
        min-width: 0;
    }

    .calendar-drag-grip {
        color: var(--color-text-muted);
        font-size: 0.85rem;
        letter-spacing: -0.15em;
        line-height: 1;
        padding: 0.2rem 0.15rem;
        user-select: none;
        flex-shrink: 0;
    }

    .nav-btn {
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text);
        font-size: 1.25rem;
        width: 2.25rem;
        height: 2.25rem;
        display: grid;
        place-items: center;
        transition: background-color 0.15s ease;
    }

    .nav-btn:hover {
        background-color: var(--color-surface-hover);
    }

    .calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .calendar-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .calendar-footer-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .calendar-month-link {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    /* ---- Variante large (dashboard) ---- */

    .calendar--large {
        /* Tamaño acotado al viewport (no al % del padre): el snapshot de la
           view-transition captura esto y evita el morph “a pantalla completa”. */
        width: min(920px, 100%);
        height: min(36rem, calc(100dvh - 9rem));
        max-width: 920px;
        max-height: min(36rem, calc(100dvh - 9rem));
        min-height: 0;
        flex: 0 0 auto;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        padding: 1rem;
        box-sizing: border-box;
        /* Por si quedara algún resto de position:fixed del modo compacto */
        position: relative !important;
        inset: auto !important;
        left: auto !important;
        top: auto !important;
        right: auto !important;
        bottom: auto !important;
        z-index: auto !important;
    }

    .calendar--large .calendar-header {
        margin-bottom: 0.5rem;
        flex-shrink: 0;
    }

    .calendar--large .calendar-weekdays {
        flex-shrink: 0;
        margin-bottom: 0.3rem;
    }

    .calendar--large .calendar-grid {
        flex: 1;
        min-height: 0;
        gap: 4px;
        grid-auto-rows: 1fr;
    }

    .calendar--large .calendar-footer {
        flex-shrink: 0;
        margin-top: 0.55rem;
    }

    .calendar--large .calendar-grid :global(.day-empty),
    .calendar--large .calendar-grid :global(.day-cell) {
        min-height: 0;
        height: 100%;
        aspect-ratio: auto;
    }

    .calendar--large .calendar-grid :global(.day-cell) {
        align-items: stretch;
        justify-content: flex-start;
        padding: 0.28rem 0.3rem 0.25rem;
        gap: 0.15rem;
    }

    .calendar--large .calendar-grid :global(.day-number) {
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1;
        align-self: flex-start;
    }

    .calendar--large .calendar-grid :global(.day-time) {
        margin-top: auto;
        align-self: flex-end;
        font-size: 0.55rem;
    }

    .calendar--large .calendar-grid :global(.day-task) {
        font-size: 0.52rem;
        padding: 0.08rem 0.22rem;
    }

    /* ---- Variante compact (sidebar, flotante en desktop) ---- */

    .calendar--compact {
        /* Encima del hueco desde el primer paint: evita el salto
           abajo→arriba cuando JS lo pasa a position:fixed */
        position: absolute;
        top: 0;
        left: 0;
        width: 268px;
        height: 320px;
        max-width: 268px;
        max-height: 320px;
        box-sizing: border-box;
        padding: 0.75rem;
        box-shadow: var(--shadow);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 1000;
    }

    /* Desktop: no mostrar hasta anclar (evita salto a posición guardada) */
    @media (min-width: 901px) {
        .calendar--compact:not(.is-floating) {
            visibility: hidden;
        }
    }

    .calendar--compact.is-draggable .calendar-header {
        cursor: grab;
    }

    .calendar--compact.is-dragging {
        cursor: grabbing;
        box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    }

    .calendar--compact.is-dragging .calendar-header {
        cursor: grabbing;
    }

    /* Acoplado bajo el menú (CSS + clase JS; sin esperar al script).
       Misma caja que el media móvil: evita salto 320px → auto al añadir
       is-docked. */
    .calendar--compact.is-docked,
    .calendar--compact.is-docked.is-floating {
        position: relative !important;
        inset: auto !important;
        left: auto !important;
        top: auto !important;
        width: 100%;
        max-width: 100%;
        height: auto;
        max-height: none;
        margin: 0;
        box-shadow: none;
        border: 1px solid var(--color-border);
        z-index: auto;
    }

    .calendar--compact.is-docked .calendar-drag-grip {
        display: none;
    }

    .calendar--compact.is-docked .calendar-header {
        cursor: default;
    }

    .calendar--compact .calendar-header {
        margin-bottom: 0.45rem;
        flex-shrink: 0;
    }

    .calendar--compact .panel-title {
        font-size: 0.85rem;
    }

    .calendar--compact .nav-btn {
        width: 1.7rem;
        height: 1.7rem;
        font-size: 0.95rem;
    }

    .calendar--compact .calendar-weekdays {
        font-size: 0.58rem;
        margin-bottom: 0.2rem;
        flex-shrink: 0;
    }

    .calendar--compact .calendar-grid {
        flex: 1;
        min-height: 0;
        gap: 2px;
        grid-auto-rows: 1fr;
    }

    .calendar--compact .calendar-footer {
        margin-top: 0.45rem;
        flex-wrap: wrap;
        flex-shrink: 0;
        gap: 0.35rem;
    }

    .calendar--compact .calendar-footer .muted-text {
        font-size: 0.7rem;
    }

    .calendar--compact .calendar-footer .btn-secondary {
        padding: 0.3rem 0.55rem;
        font-size: 0.72rem;
    }

    .calendar--compact .calendar-grid :global(.day-empty),
    .calendar--compact .calendar-grid :global(.day-cell) {
        aspect-ratio: auto;
        min-height: 0;
        height: 100%;
    }

    .calendar--compact .calendar-grid :global(.day-cell) {
        padding: 0.1rem;
        gap: 1px;
    }

    .calendar--compact .calendar-grid :global(.day-number) {
        font-size: 0.68rem;
    }

    .calendar--compact .calendar-grid :global(.day-time) {
        font-size: 0.48rem;
    }

    /* Las @media no suman especificidad: este bloque tiene que ir DESPUÉS de
       las reglas base `.calendar--compact …` o queda anulado por ellas. */
    @media (max-width: 900px) {
        .calendar--compact,
        .calendar--compact.is-docked,
        .calendar--compact.is-docked.is-floating {
            position: relative !important;
            inset: auto !important;
            left: auto !important;
            top: auto !important;
            width: 100%;
            max-width: 100%;
            /* Alto al contenido: evita el rectángulo vacío bajo los botones */
            height: auto;
            max-height: none;
            margin: 0;
            padding: 0.45rem 0.55rem;
            box-shadow: none;
            border: 1px solid var(--color-border);
            z-index: auto;
        }

        .calendar--compact .calendar-drag-grip {
            display: none;
        }

        .calendar--compact .calendar-header {
            cursor: default;
            margin-bottom: 0.25rem;
        }

        .calendar--compact .panel-title {
            font-size: 0.8rem;
        }

        .calendar--compact .nav-btn {
            width: 1.5rem;
            height: 1.5rem;
            font-size: 0.85rem;
        }

        .calendar--compact .calendar-weekdays {
            font-size: 0.52rem;
            margin-bottom: 0.1rem;
        }

        .calendar--compact .calendar-grid {
            flex: none;
            grid-auto-rows: 1.35rem;
            gap: 1px;
            /* 6 filas fijas: el mes no cambia de alto al cargar celdas/API */
            min-height: calc(6 * 1.35rem + 5 * 1px);
        }

        .calendar--compact .calendar-footer {
            margin-top: 0.35rem;
            gap: 0.35rem;
            flex-wrap: wrap;
        }

        .calendar--compact .calendar-footer .muted-text {
            font-size: 0.65rem;
        }

        .calendar--compact .calendar-footer .btn-secondary {
            padding: 0.22rem 0.45rem;
            font-size: 0.68rem;
        }

        .calendar--compact .calendar-grid :global(.day-empty),
        .calendar--compact .calendar-grid :global(.day-cell) {
            height: 1.35rem;
            min-height: 0;
        }

        .calendar--compact .calendar-grid :global(.day-number) {
            font-size: 0.62rem;
        }

        .calendar--compact .calendar-grid :global(.day-time) {
            display: none;
        }

        .calendar--compact .calendar-grid :global(.day-dots) {
            gap: 1px;
        }

        .calendar--compact .calendar-grid :global(.day-dot) {
            width: 3px;
            height: 3px;
        }
    }

    /*
        Las celdas se crean con JS, de ahí los selectores :global() para que
        les apliquen los estilos scoped del componente
    */

    .calendar-grid :global(.day-cell) {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        background: none;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--color-text);
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease;
        overflow: hidden;
    }

    .calendar-grid :global(.day-number) {
        font-size: 0.9rem;
    }

    .calendar-grid :global(.day-time) {
        font-size: 0.6rem;
        color: var(--color-success);
        font-weight: 600;
        line-height: 1;
    }

    .calendar-grid :global(.day-tasks) {
        display: flex;
        flex-direction: column;
        gap: 2px;
        width: 100%;
        min-height: 0;
        flex: 1;
        overflow: hidden;
    }

    .calendar-grid :global(.day-task) {
        display: block;
        font-size: 0.58rem;
