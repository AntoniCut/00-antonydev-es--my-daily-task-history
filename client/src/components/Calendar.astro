// Calendario mensual propio: muestra el tiempo registrado en cada día y
// permite seleccionar el día que se consulta en el panel de registros.


---



<div 
    id="calendar" 
    class="calendar panel"
>
    
    <div class="calendar-header">
        
        <button
            class="nav-btn"
            type="button"
            data-prev
            aria-label="Mes anterior">‹</button
        >
        
        <h2 class="panel-title" data-title></h2>
        
        <button
            class="nav-btn"
            type="button"
            data-next
            aria-label="Mes siguiente">›</button
        >

    </div>

    <div class="calendar-weekdays">
        <span>Lun</span>
        <span>Mar</span>
        <span>Mié</span>
        <span>Jue</span>
        <span>Vie</span>
        <span>Sáb</span>
        <span>Dom</span>
    </div>

    <div 
        class="calendar-grid" 
        role="grid" 
        data-grid
    > </div>

    <footer class="calendar-footer">
        
        <p class="muted-text" data-month-total> </p>
        
        <button 
            class="btn-secondary" 
            type="button" 
            data-today
        > 
            Hoy 
        </button>

    </footer>

</div>


<script>
    
    import { api } from '../lib/api';
    import { create, onPageReady, query } from '../lib/dom';
    import { emitDateSelected, onDataChanged } from '../lib/events';
    import { MONTH_NAMES, formatMinutes, todayKey } from '../lib/time';

    onPageReady((signal) => {
        const root = document.getElementById('calendar');
        if (!root) return;

        const titleEl = query<HTMLHeadingElement>(root, '[data-title]');
        const gridEl = query<HTMLDivElement>(root, '[data-grid]');
        const totalEl = query<HTMLParagraphElement>(root, '[data-month-total]');
        const prevBtn = query<HTMLButtonElement>(root, '[data-prev]');
        const nextBtn = query<HTMLButtonElement>(root, '[data-next]');
        const todayBtn = query<HTMLButtonElement>(root, '[data-today]');

        const today = todayKey();
        const pad = (value: number) => String(value).padStart(2, '0');

        let [viewYear, viewMonth] = [
            Number(today.slice(0, 4)),
            Number(today.slice(5, 7)) - 1,
        ];
        let selectedDate = today;
        let minutesByDate = new Map<string, number>();

        const loadMonth = async (): Promise<void> => {
            const month = `${viewYear}-${pad(viewMonth + 1)}`;
            try {
                const days = await api.getDayTotals({ month });
                minutesByDate = new Map(
                    days.map((day) => [day.date, day.minutes]),
                );
            } catch {
                minutesByDate = new Map();
            }
        };

        const select = (dateKey: string): void => {
            selectedDate = dateKey;
            emitDateSelected(dateKey);
            render();
        };

        const render = (): void => {
            titleEl.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
            gridEl.innerHTML = '';

            // Desplazamiento para que la semana empiece en lunes
            const firstWeekday =
                (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

            for (let i = 0; i < firstWeekday; i++) {
                gridEl.appendChild(create('span', { className: 'day-empty' }));
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dateKey = `${viewYear}-${pad(viewMonth + 1)}-${pad(day)}`;
                const minutes = minutesByDate.get(dateKey) ?? 0;

                const cell = create('button', {
                    className: 'day-cell',
                    attrs: { type: 'button', 'aria-label': dateKey },
                });
                if (dateKey === today) cell.classList.add('is-today');
                if (dateKey === selectedDate) cell.classList.add('is-selected');
                if (minutes) cell.classList.add('has-time');

                cell.appendChild(
                    create('span', {
                        className: 'day-number',
                        text: String(day),
                    }),
                );
                cell.appendChild(
                    create('span', {
                        className: 'day-time',
                        text: minutes ? formatMinutes(minutes) : '',
                    }),
                );

                cell.addEventListener('click', () => select(dateKey), {
                    signal,
                });
                gridEl.appendChild(cell);
            }

            const monthMinutes = [...minutesByDate.values()].reduce(
                (total, minutes) => total + minutes,
                0,
            );
            totalEl.textContent = `Total del mes: ${formatMinutes(monthMinutes)}`;
        };

        const refresh = async (): Promise<void> => {
            await loadMonth();
            render();
        };

        const moveMonth = (offset: number): void => {
            const date = new Date(viewYear, viewMonth + offset, 1);
            viewYear = date.getFullYear();
            viewMonth = date.getMonth();
            void refresh();
        };

        prevBtn.addEventListener('click', () => moveMonth(-1), { signal });
        nextBtn.addEventListener('click', () => moveMonth(1), { signal });

        todayBtn.addEventListener(
            'click',
            () => {
                viewYear = Number(today.slice(0, 4));
                viewMonth = Number(today.slice(5, 7)) - 1;
                void refresh().then(() => select(today));
            },
            { signal },
        );

        onDataChanged(() => void refresh(), { signal });

        void refresh().then(() => emitDateSelected(selectedDate));
    });

</script>



<style>
    
    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }
    
    .nav-btn {
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text);
        font-size: 1.25rem;
        width: 2.25rem;
        height: 2.25rem;
        display: grid;
        place-items: center;
        transition: background-color 0.15s ease;
    }

    .nav-btn:hover {
        background-color: var(--color-surface-hover);
    }

    .calendar-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--color-text-muted);
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
    }

    .calendar-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    /* 
        Las celdas se crean con JS, de ahí los selectores :global() para que
        les apliquen los estilos scoped del componente 
    */

    .calendar-grid :global(.day-empty) {
        aspect-ratio: 1;
    }

    .calendar-grid :global(.day-cell) {
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        background: none;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--color-text);
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease;
    }

    .calendar-grid :global(.day-number) {
        font-size: 0.9rem;
    }

    .calendar-grid :global(.day-time) {
        font-size: 0.6rem;
        color: var(--color-success);
        font-weight: 600;
        line-height: 1;
    }

    .calendar-grid :global(.day-cell:hover) {
        background-color: var(--color-surface-hover);
    }

    .calendar-grid :global(.day-cell.has-time) {
        background-color: color-mix(
            in srgb,
            var(--color-success) 12%,
            transparent
        );
    }

    .calendar-grid :global(.day-cell.is-today) {
        border-color: var(--color-primary);
    }

    .calendar-grid :global(.day-cell.is-selected) {
        background-color: var(--color-primary);
        font-weight: 700;
    }

    .calendar-grid :global(.day-cell.is-selected .day-time) {
        color: #fff;
    }


</style>
