---
/*
 *  -----------------------------------------------------------------------------  *
 *  -----  TaskManager.astro  --  /client/src/components/TaskManager.astro  -----  *
 *  -----------------------------------------------------------------------------  *
 */

// Gestor completo: alta de tareas (con sus subtareas), modificación, baja
// lógica y eliminación. El tiempo se registra en el Dashboard (vista diaria).
---

<div id="task-manager" class="manager">
    <form class="panel new-task" data-new-form>
        <h2 class="panel-title">Nueva tarea</h2>
        <p class="panel-subtitle">
            Puedes añadir sus subtareas antes de darla de alta.
        </p>

        <div class="field">
            <label for="new-title">Título</label>
            <input
                id="new-title"
                type="text"
                data-title
                maxlength="120"
                placeholder="Informática, Extracolor noche, Otras tareas..."
                required
            />
        </div>

        <div class="field">
            <label for="new-description">Descripción</label>
            <textarea
                id="new-description"
                rows="2"
                data-description
                placeholder="Opcional"></textarea>
        </div>

        <div class="field field-color">
            <label for="new-color">Color</label>
            <input id="new-color" type="color" data-color aria-label="Color de la tarea" />
        </div>

        <div class="field">
            <label>Subtareas</label>
            <div class="subtask-inputs" data-subtask-inputs></div>
            <button
                class="btn-secondary btn-inline"
                type="button"
                data-add-input
            >
                + Añadir subtarea
            </button>
        </div>

        <div class="new-task-actions">
            <button class="btn-primary" type="submit">Dar de alta</button>
        </div>

        <p class="error-text" data-new-error role="alert" hidden></p>
    </form>

    <section class="panel task-tree">
        <header class="tree-header">
            <div>
                <h2 class="panel-title">Tareas y subtareas</h2>
                <p class="panel-subtitle" data-count></p>
            </div>
            <label class="toggle-inactive">
                <input type="checkbox" data-show-inactive />
                Ver dadas de baja
            </label>
        </header>

        <p class="error-text" data-tree-error role="alert" hidden></p>
        <div class="tree-body">
            <ul class="task-list" data-list></ul>
            <p class="empty-text" data-empty hidden>
                Todavía no hay tareas dadas de alta.
            </p>
        </div>
    </section>
</div>

<script>
    import { api } from '../lib/api';
    import { nextColor, resolveSubtaskColor } from '../lib/colors';
    import { create, onPageReady, query, showConfirm, showError } from '../lib/dom';
    import { emitDataChanged, onDataChanged } from '../lib/events';
    import { formatMinutes } from '../lib/time';
    import type { Subtask, SubtaskDraft, Task, TimeEntry } from '../../types/types';

    onPageReady((signal) => {
        /*
            *  ---------------------------------  *
            *  -----  Referencias al HTML  -----  *
            *  ---------------------------------  *
        */

        // - `Contenedor raíz del gestor de tareas`
        const root = document.getElementById('task-manager') as HTMLDivElement | null;
        if (!root) return;

        // - `Formulario para crear tareas`
        const newForm = query<HTMLFormElement>(root, '[data-new-form]');

        // - `Campo del título de la tarea`
        const titleInput = query<HTMLInputElement>(root, '[data-title]');

        // - `Campo de la descripción de la tarea`
        const descInput = query<HTMLTextAreaElement>(
            root,
            '[data-description]',
        );

        // - `Selector de color de la tarea`
        const colorInput = query<HTMLInputElement>(root, '[data-color]');

        // - `Contenedor de filas de subtareas`
        const subtaskInputs = query<HTMLDivElement>(
            root,
            '[data-subtask-inputs]',
        );

        // - `Botón para añadir otra subtarea`
        const addInputBtn = query<HTMLButtonElement>(root, '[data-add-input]');

        // - `Mensaje de error del formulario de alta`
        const newErrorEl = query<HTMLParagraphElement>(
            root,
            '[data-new-error]',
        );

        // - `Mensaje de error del árbol de tareas`
        const treeErrorEl = query<HTMLParagraphElement>(
            root,
            '[data-tree-error]',
        );

        // - `Listado de tareas renderizado`
        const listEl = query<HTMLUListElement>(root, '[data-list]');

        // - `Estado vacío del árbol`
        const emptyEl = query<HTMLParagraphElement>(root, '[data-empty]');

        // - `Contador de tareas activas e inactivas`
        const countEl = query<HTMLParagraphElement>(root, '[data-count]');

        // - `Checkbox para mostrar tareas dadas de baja`
        const showInactiveInput = query<HTMLInputElement>(
            root,
            '[data-show-inactive]',
        );

        let tasks: Task[] = [];

        /* ----------  Totales (solo para avisos de borrado)  ----------- */

        /**
         * --------------------------------------
         * -----  `sumEntries(entries)`  -----
         * --------------------------------------
         * - Suma los minutos de una colección de registros.
         */
        const sumEntries = (entries: TimeEntry[]): number =>
            entries.reduce((total, entry) => total + entry.minutes, 0);

        /**
         * -----------------------------------
         * -----  `taskMinutes(task)`  -----
         * -----------------------------------
         * - Calcula el tiempo total de una tarea y sus subtareas.
         */
        const taskMinutes = (task: Task): number =>
            sumEntries(task.entries) +
            task.subtasks.reduce(
                (total, subtask) => total + sumEntries(subtask.entries),
                0,
            );

        /* ----------------------  Formularios inline  ------------------- */

        /**
         * ------------------------------------------
         * -----  `togglePanel(host, kind, build)`  -----
         * ------------------------------------------
         * - Abre o cierra el panel inline asociado a una fila.
         */
        const togglePanel = (
            host: HTMLElement,
            kind: string,
            build: () => HTMLElement,
        ): void => {
            const open = host.querySelector(`[data-panel="${kind}"]`);
            host.replaceChildren();

            //  -----  si ese panel ya estaba abierto, dejarlo cerrado  -----
            if (open) return;

            const panel = build();
            panel.dataset.panel = kind;
            host.appendChild(panel);
            panel.querySelector<HTMLElement>('input, textarea')?.focus();
        };

        /**
         * ------------------------------------
         * -----  `inlineInput(value, attrs)`  -----
         * ------------------------------------
         * - Crea un input de texto para formularios inline.
         */
        const inlineInput = (
            value: string,
            attrs: Record<string, string> = {},
        ): HTMLInputElement =>
            create('input', {
                className: 'inline-input',
                attrs: { value, ...attrs },
            });

        /**
         * --------------------------------------
         * -----  `inlineColor(value, label)`  -----
         * --------------------------------------
         * - Crea un selector de color para formularios inline.
         */
        const inlineColor = (value: string, label: string): HTMLInputElement =>
            create('input', {
                className: 'inline-color',
                attrs: {
                    type: 'color',
                    value,
                    'aria-label': label,
                },
            });

        /**
         * --------------------------------------
         * -----  `inlineActions(submitText)`  -----
         * --------------------------------------
         * - Crea el bloque de acciones de un formulario inline.
         */
        const inlineActions = (submitText: string): HTMLDivElement => {
            const actions = create('div', { className: 'inline-actions' });
            actions.append(
                create('button', {
                    className: 'btn-primary',
                    text: submitText,
                    attrs: { type: 'submit' },
                }),
                create('button', {
                    className: 'btn-secondary',
                    text: 'Cancelar',
                    attrs: { type: 'button', 'data-cancel': '' },
                }),
            );
            return actions;
        };

        /**
         * ---------------------------------------
         * -----  `inlineForm(children, save)`  -----
         * ---------------------------------------
         * - Envuelve un formulario inline y delega su guardado.
         */
        const inlineForm = (
            children: HTMLElement[],
            save: () => Promise<unknown>,
        ): HTMLFormElement => {
            const form = create('form', { className: 'inline-form' });
            form.append(...children);

            form.querySelector('[data-cancel]')?.addEventListener(
                'click',
                () => void load(),
                { signal },
            );

            form.addEventListener('submit', (event: SubmitEvent) => {
                event.preventDefault();
                save()
                    .then(emitDataChanged)
                    .catch((error: Error) =>
                        showError(treeErrorEl, error.message),
                    );
            });

            return form;
        };

        /**
         * ---------------------------------------
         * -----  `buildTaskEditForm(task)`  -----
         * ---------------------------------------
         * - Construye el formulario inline para editar una tarea.
         */
        const buildTaskEditForm = (task: Task): HTMLFormElement => {
            const title = inlineInput(task.title, {
                type: 'text',
                maxlength: '120',
                required: 'true',
                'aria-label': 'Título de la tarea',
            });
            const description = inlineInput(task.description ?? '', {
                type: 'text',
                maxlength: '250',
                placeholder: 'Descripción',
                'aria-label': 'Descripción',
            });
            const color = inlineColor(task.color, 'Color de la tarea');

            return inlineForm(
                [title, description, color, inlineActions('Guardar')],
                () =>
                    api.updateTask(task.id, {
                        title: title.value,
                        description: description.value,
                        color: color.value,
                    }),
            );
        };

        /**
         * -------------------------------------------------
         * -----  `buildSubtaskEditForm(task, subtask)`  -----
         * -------------------------------------------------
         * - Construye el formulario inline para editar una subtarea.
         */
        const buildSubtaskEditForm = (
            task: Task,
            subtask: Subtask,
        ): HTMLFormElement => {
            const title = inlineInput(subtask.title, {
                type: 'text',
                maxlength: '120',
                required: 'true',
                'aria-label': 'Título de la subtarea',
            });
            const color = inlineColor(
                resolveSubtaskColor(subtask, task),
                'Color de la subtarea',
            );

            return inlineForm([title, color, inlineActions('Guardar')], () =>
                api.updateSubtask(task.id, subtask.id, {
                    title: title.value,
                    color: color.value,
                }),
            );
        };

        /**
         * --------------------------------------
         * -----  `buildNewSubtaskForm(task)`  -----
         * --------------------------------------
         * - Construye el formulario inline para crear una subtarea.
         */
        const buildNewSubtaskForm = (task: Task): HTMLFormElement => {
            const title = inlineInput('', {
                type: 'text',
                maxlength: '120',
                required: 'true',
                placeholder: 'Nueva subtarea',
                'aria-label': 'Título de la nueva subtarea',
            });
            const color = inlineColor(task.color, 'Color de la subtarea');

            return inlineForm([title, color, inlineActions('Añadir')], () =>
                api.createSubtask(task.id, {
                    title: title.value,
                    color: color.value,
                }),
            );
        };

        /* -------------------------  Acciones  -------------------------- */

        /**
         * --------------------------------
         * -----  `run(action)`  -----
         * --------------------------------
         * - Ejecuta una acción remota y propaga el refresco global.
         */
        const run = (action: Promise<unknown>): void => {
            action
                .then(emitDataChanged)
                .catch((error: Error) => showError(treeErrorEl, error.message));
        };

        /**
         * ---------------------------------------------
         * -----  `iconButton(text, title, onClick)`  -----
         * ---------------------------------------------
         * - Crea un botón de icono y vincula su acción.
         */
        const iconButton = (
            text: string,
            title: string,
            onClick: () => void,
        ): HTMLButtonElement => {
            const button = create('button', {
                className: 'icon-btn',
                text,
                title,
                attrs: { type: 'button' },
            });
            button.addEventListener('click', onClick, { signal });
            return button;
        };

        /* -------------------------  Renderizado  ----------------------- */

        /**
         * --------------------------------------------
         * -----  `renderSubtask(task, subtask)`  -----
         * --------------------------------------------
         * - Renderiza una fila de subtarea con sus acciones.
         */
        const renderSubtask = (task: Task, subtask: Subtask): HTMLLIElement => {
            const item = create('li', { className: 'subtask-item' });
            if (!subtask.active) item.classList.add('is-inactive');
            if (subtask.completed) item.classList.add('is-completed');

            const row = create('div', { className: 'row' });

            const color = create('span', { className: 'subtask-color' });
            color.style.backgroundColor = resolveSubtaskColor(subtask, task);

            const checkbox = create('input', {
                className: 'row-check',
                attrs: {
                    type: 'checkbox',
                    'aria-label': `Marcar "${subtask.title}" como completada`,
                },
            });
            checkbox.checked = subtask.completed;
            checkbox.addEventListener(
                'change',
                () =>
                    run(
                        api.updateSubtask(task.id, subtask.id, {
                            completed: checkbox.checked,
                        }),
                    ),
                { signal },
            );

            const name = create('span', {
                className: 'row-title',
                text: subtask.title,
            });

            const total = sumEntries(subtask.entries);
            const badges = create('div', { className: 'row-badges' });
            if (!subtask.active) {
                badges.appendChild(
                    create('span', { className: 'badge', text: 'baja' }),
                );
            }

            const panelHost = create('div', { className: 'panel-host' });
            const actions = create('div', { className: 'row-actions' });
            actions.append(
                iconButton('✏️', 'Modificar subtarea', () =>
                    togglePanel(panelHost, 'edit', () =>
                        buildSubtaskEditForm(task, subtask),
                    ),
                ),
                iconButton(
                    subtask.active ? '⏸' : '▶',
                    subtask.active ? 'Dar de baja' : 'Volver a dar de alta',
                    () =>
                        run(
                            api.updateSubtask(task.id, subtask.id, {
                                active: !subtask.active,
                            }),
                        ),
                ),
                iconButton('🗑️', 'Eliminar subtarea', () => {
                    void showConfirm({
                        title: 'Eliminar subtarea',
                        message: `¿Eliminar la subtarea "${subtask.title}" y sus ${formatMinutes(total)} registrados?`,
                        confirmText: 'Eliminar',
                        danger: true,
                    }).then((confirmed) => {
                        //  -----  si se cancela la confirmación, no eliminar la subtarea  -----
                        if (!confirmed) return;
                        run(api.deleteSubtask(task.id, subtask.id));
                    });
                }),
            );

            row.append(color, checkbox, name, badges, actions);
            item.append(row, panelHost);
            return item;
        };

        /**
         * ----------------------------------
         * -----  `renderTask(task)`  -----
         * ----------------------------------
         * - Renderiza una tarea con sus subtareas visibles.
         */
        const renderTask = (task: Task): HTMLLIElement => {
            const item = create('li', { className: 'task-item' });
            if (!task.active) item.classList.add('is-inactive');
            if (task.completed) item.classList.add('is-completed');

            const row = create('div', { className: 'row task-row' });

            const color = create('span', { className: 'task-color' });
            color.style.backgroundColor = task.color;

            const checkbox = create('input', {
                className: 'row-check',
                attrs: {
                    type: 'checkbox',
                    'aria-label': `Marcar "${task.title}" como completada`,
                },
            });
            checkbox.checked = task.completed;
            checkbox.addEventListener(
                'change',
                () =>
                    run(
                        api.updateTask(task.id, {
                            completed: checkbox.checked,
                        }),
                    ),
                { signal },
            );

            const info = create('div', { className: 'task-info' });
            info.appendChild(
                create('span', { className: 'row-title', text: task.title }),
            );
            if (task.description) {
                info.appendChild(
                    create('span', {
                        className: 'task-description',
                        text: task.description,
                    }),
                );
            }

            const total = taskMinutes(task);
            const badges = create('div', { className: 'row-badges' });
            if (task.subtasks.length) {
                badges.appendChild(
                    create('span', {
                        className: 'badge',
                        text: `${task.subtasks.length} subtarea${task.subtasks.length === 1 ? '' : 's'}`,
                    }),
                );
            }
            if (!task.active) {
                badges.appendChild(
                    create('span', { className: 'badge', text: 'baja' }),
                );
            }

            const panelHost = create('div', { className: 'panel-host' });
            const actions = create('div', { className: 'row-actions' });
            actions.append(
                iconButton('＋', 'Añadir subtarea', () =>
                    togglePanel(panelHost, 'subtask', () =>
                        buildNewSubtaskForm(task),
                    ),
                ),
                iconButton('✏️', 'Modificar tarea', () =>
                    togglePanel(panelHost, 'edit', () =>
                        buildTaskEditForm(task),
                    ),
                ),
                iconButton(
                    task.active ? '⏸' : '▶',
                    task.active ? 'Dar de baja' : 'Volver a dar de alta',
                    () =>
                        run(api.updateTask(task.id, { active: !task.active })),
                ),
                iconButton('🗑️', 'Eliminar tarea', () => {
                    void showConfirm({
                        title: 'Eliminar tarea',
                        message: `¿Eliminar "${task.title}", sus ${task.subtasks.length} subtareas y sus ${formatMinutes(total)} registrados?`,
                        confirmText: 'Eliminar',
                        danger: true,
                    }).then((confirmed) => {
                        //  -----  si se cancela la confirmación, no eliminar la tarea  -----
                        if (!confirmed) return;
                        run(api.deleteTask(task.id));
                    });
                }),
            );

            row.append(color, checkbox, info, badges, actions);
            item.append(row, panelHost);

            const visibleSubtasks = task.subtasks.filter(
                (subtask) => subtask.active || showInactiveInput.checked,
            );

            //  -----  si hay subtareas visibles, renderizar la lista hija  -----
            if (visibleSubtasks.length) {
                const subtaskList = create('ul', { className: 'subtask-list' });
                subtaskList.append(
                    ...visibleSubtasks.map((subtask) =>
                        renderSubtask(task, subtask),
                    ),
                );
                item.appendChild(subtaskList);
            }

            return item;
        };

        /**
         * ----------------------------
         * -----  `render()`  -----
         * ----------------------------
         * - Pinta el árbol según el filtro de activas e inactivas.
         */
        const render = (): void => {
            const visible = tasks.filter(
                (task) => task.active || showInactiveInput.checked,
            );
            listEl.replaceChildren(...visible.map(renderTask));
            emptyEl.hidden = visible.length > 0;

            const active = tasks.filter((task) => task.active).length;
            countEl.textContent = `${active} de alta · ${tasks.length - active} de baja`;
        };

        /**
         * --------------------------
         * -----  `load()`  -----
         * --------------------------
         * - Carga las tareas y refresca la vista principal.
         */
        const load = async (): Promise<void> => {
            try {
                tasks = await api.getTasks();
                setDefaultTaskColor();
                render();
                showError(treeErrorEl, null);
            }
            //  -----  si la carga falla, mostrar el error  -----
            catch (error) {
                showError(treeErrorEl, (error as Error).message);
            }
        };

        /* ------------------  Alta de tareas con subtareas  -------------- */

        /**
         * ------------------------------------
         * -----  `setDefaultTaskColor()`  -----
         * ------------------------------------
         * - Asigna el siguiente color sugerido para una nueva tarea.
         */
        const setDefaultTaskColor = (): void => {
            colorInput.value = nextColor(tasks.filter((task) => task.active).length);
        };

        /**
         * --------------------------------
         * -----  `addSubtaskInput()`  -----
         * --------------------------------
         * - Añade una nueva fila de subtarea al formulario de alta.
         */
        const addSubtaskInput = (): void => {
            const row = create('div', { className: 'subtask-input-row' });
            const input = create('input', {
                attrs: {
                    type: 'text',
                    maxlength: '120',
                    placeholder: `Subtarea ${subtaskInputs.children.length + 1}`,
                    'aria-label': 'Título de la subtarea',
                },
            });
            const color = create('input', {
                className: 'subtask-color-input',
                attrs: {
                    type: 'color',
                    value: colorInput.value,
                    'aria-label': 'Color de la subtarea',
                },
            });
            const remove = create('button', {
                className: 'icon-btn',
                text: '✕',
                title: 'Quitar esta subtarea',
                attrs: { type: 'button' },
            });
            remove.addEventListener('click', () => row.remove(), { signal });

            row.append(input, color, remove);
            subtaskInputs.appendChild(row);
            input.focus();
        };

        /**
         * --------------------------------
         * -----  `resetNewForm()`  -----
         * --------------------------------
         * - Restablece el formulario de alta a su estado inicial.
         */
        const resetNewForm = (): void => {
            newForm.reset();
            setDefaultTaskColor();
            subtaskInputs.replaceChildren();
            addSubtaskInput();
            showError(newErrorEl, null);
        };

        addInputBtn.addEventListener('click', addSubtaskInput, { signal });

        newForm.addEventListener(
            'submit',
            (event: SubmitEvent) => {
                event.preventDefault();
                const subtasks = [
                    ...subtaskInputs.querySelectorAll<HTMLDivElement>(
                        '.subtask-input-row',
                    ),
                ]
                    .map((row) => {
                        const title =
                            row.querySelector<HTMLInputElement>(
                                'input[type="text"]',
                            )?.value.trim() ?? '';

                        //  -----  si el título está vacío, omitir la subtarea  -----
                        if (!title) return null;

                        const color =
                            row.querySelector<HTMLInputElement>(
                                'input[type="color"]',
                            )?.value;

                        return color ? { title, color } : { title };
                    })
                    .filter((subtask): subtask is SubtaskDraft => subtask !== null);

                api.createTask({
                    title: titleInput.value,
                    description: descInput.value,
                    color: colorInput.value,
                    subtasks,
                })
                    .then(() => {
                        resetNewForm();
                        emitDataChanged();
                    })
                    .catch((error: Error) =>
                        showError(newErrorEl, error.message),
                    );
            },
            { signal },
        );

        showInactiveInput.addEventListener('change', render, { signal });
        onDataChanged(() => void load(), { signal });

        colorInput.value = nextColor(0);
        addSubtaskInput();
        void load();
    });
</script>

<style>
    .manager {
        display: grid;
        grid-template-columns: minmax(280px, 340px) 1fr;
        gap: 1rem;
        align-items: stretch;
        flex: 1;
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .new-task {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        align-self: start;
        width: 100%;
    }

    .new-task .panel-subtitle {
        margin-top: -0.45rem;
    }

    .task-tree {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .tree-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding-right: 0.15rem;
    }

    .field-color input[type='color'] {
        width: 3rem;
        height: 2.35rem;
        padding: 2px;
        cursor: pointer;
    }

    .subtask-inputs {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        /* JS inserta la primera fila al cargar: reservar su alto evita que el
           formulario empuje al listado. */
        min-height: 2.35rem;
    }

    .subtask-inputs :global(.subtask-input-row) {
        display: flex;
        gap: 0.4rem;
    }

    .subtask-inputs :global(input) {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text);
        padding: 0.5rem 0.65rem;
        font-size: 0.9rem;
        flex: 1;
        min-width: 0;
    }

    .subtask-inputs :global(.subtask-color-input) {
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        width: 2.35rem;
        height: 2.35rem;
        padding: 2px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .subtask-inputs :global(input:focus) {
        outline: none;
        border-color: var(--color-primary);
    }

    .btn-inline {
        align-self: flex-start;
        font-size: 0.82rem;
        padding: 0.35rem 0.7rem;
    }

    .new-task-actions {
        display: flex;
        gap: 0.6rem;
    }

    .tree-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
