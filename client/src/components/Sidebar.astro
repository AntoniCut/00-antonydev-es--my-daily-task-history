---
/*
    *  ---------------------------------------------------------------------  *
    *  -----  Sidebar.astro  --  /client/src/components/Sidebar.astro  -----  *
    *  ---------------------------------------------------------------------  *
*/

// Navegación lateral del dashboard. En la vista de un día muestra el
// calendario compacto debajo de Informes (flotante en desktop; acoplado
// bajo el menú en pantallas pequeñas).

import Logo from './Logo.astro';
import Calendar from './Calendar.astro';

interface Props {
    active: 'dashboard' | 'tasks' | 'reports';
    /** Si hay fecha, se muestra el calendario compacto bajo la nav. */
    calendarDate?: string;
}

const { active, calendarDate } = Astro.props;

const links = [
    { id: 'dashboard', href: '/', label: 'Dashboard', icon: '▤' },
    { id: 'tasks', href: '/tareas', label: 'Tareas', icon: '✎' },
    { id: 'reports', href: '/informes', label: 'Informes', icon: '↗' },
] as const;
---

<aside class="sidebar">
    <a class="brand" href="/">
        <Logo size={40} />
        <span class="brand-text">
            <strong>
                MyDailyTaskHistory
                <br />
                Gestor de tareas
            </strong>
            <small>Control de tiempo</small>
        </span>
    </a>

    <nav class="nav" aria-label="Secciones">
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class:list={[
                        'nav-link',
                        { 'is-active': link.id === active },
                    ]}
                    aria-current={link.id === active ? 'page' : undefined}
                >
                    <span class="nav-icon" aria-hidden="true">
                        {link.icon}
                    </span>
                    {link.label}
                </a>
            ))
        }
    </nav>

    {
        calendarDate && (
            <div
                class="sidebar-calendar-host"
                id="sidebar-calendar-host"
                aria-label="Calendario del día"
            >
                {/* Hueco reservado: el panel real es position:fixed y no empuja el layout */}
                <div class="sidebar-calendar-slot" aria-hidden="true" />
                <Calendar variant="compact" selectedDate={calendarDate} />
            </div>
        )
    }

    <div class="sidebar-foot">
        <p class="sidebar-note">Datos guardados en tu propio servidor</p>
        <button
            type="button"
            class="logout-btn"
            id="logout-button"
            title="Cerrar sesión"
        >
            Cerrar sesión
        </button>
    </div>
</aside>

<script>
    import { api } from '../lib/api';
    import { onPageReady } from '../lib/dom';

    /**
     * -----------------------------------
     * -----  `bindLogout()`  -----
     * -----------------------------------
     * - Cierra la sesión y redirige al login.
     */
    const bindLogout = (signal: AbortSignal): void => {
        /*
         *  ---------------------------------  *
         *  -----  Referencias al HTML  -----  *
         *  ---------------------------------  *
         */

        // - `Botón de cierre de sesión`
        const button = document.getElementById(
            'logout-button',
        ) as HTMLButtonElement | null;

        //  -----  si no existe el botón, salir  -----
        if (!button) return;

        //  -----  si ya está vinculado, no duplicar el listener  -----
        if (button.dataset.bound === 'true') return;

        button.dataset.bound = 'true';

        button.addEventListener(
            'click',
            async (event: MouseEvent): Promise<void> => {
                event.preventDefault();

                //  -----  intentar cerrar la sesión; se redirige igualmente  -----
                try {
                    await api.logout();
                } catch {
                    //  -----  si falla, el login acabará rechazando la sesión igualmente  -----
                }

                window.location.replace('/login');
            },
            { signal },
        );
    };

    //  -----  se inicializa en cada carga de página  -----
    onPageReady(bindLogout);
</script>

<style>
    .sidebar {
        background-color: var(--color-surface);
        border-right: 1px solid var(--color-border);
        padding: 1rem 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        position: relative;
        z-index: 20;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 3rem;
        color: inherit;
        text-decoration: none;
    }

    .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .brand-text strong {
        font-size: 1rem;
    }

    .brand-text small {
        color: var(--color-text-muted);
        font-size: 0.75rem;
    }

    .nav {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex-shrink: 0;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.45rem 0.65rem;
        border-radius: 8px;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition:
            background-color 0.15s ease,
            color 0.15s ease;
    }

    .nav-link:hover {
        background-color: var(--color-surface-hover);
        color: var(--color-text);
    }

    .nav-link.is-active {
        background-color: color-mix(
            in srgb,
            var(--color-primary) 18%,
            transparent
        );
        color: var(--color-primary);
    }

    .nav-icon {
        width: 1.25rem;
        text-align: center;
    }

    /* Reserva sitio en el aside; el calendario flota encima (fixed) */
    .sidebar-calendar-host {
        position: relative;
        width: 100%;
        flex-shrink: 0;
    }

    .sidebar-calendar-slot {
        width: 268px;
        height: 320px;
        pointer-events: none;
    }

    /* Desktop: ocultar hueco cuando el calendario ya está acoplado por JS */
    .sidebar-calendar-host:global(.is-calendar-docked) .sidebar-calendar-slot {
        display: none;
    }

    .sidebar-foot {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .sidebar-note {
        color: var(--color-text-muted);
        font-size: 0.72rem;
    }

    .logout-btn {
        align-self: flex-start;
        background: none;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        color: var(--color-text-muted);
        font-size: 0.82rem;
        font-weight: 500;
        padding: 0.35rem 0.8rem;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .logout-btn:hover {
        color: var(--color-danger);
        border-color: var(--color-danger);
    }

    @media (max-width: 900px) {
        .sidebar {
            border-right: none;
            border-bottom: 1px solid var(--color-border);
            gap: 0.55rem;
            padding: 0.65rem 0.75rem;
            flex-shrink: 0;
        }

        .brand {
            gap: 0.75rem;
        }

        .brand :global(svg) {
            width: 32px;
            height: 32px;
        }

        .brand-text strong {
            font-size: 0.85rem;
        }

        .brand-text small {
            display: none;
        }

        .nav {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0.2rem;
        }

        .nav-link {
            padding: 0.35rem 0.55rem;
            font-size: 0.85rem;
        }

        .sidebar-calendar-host {
            width: 100%;
            margin-bottom: 0.15rem;
        }

        /* Sin esperar a JS: en móvil el slot de 320px no debe ocupar sitio */
        .sidebar-calendar-slot {
            display: none;
            width: 0;
            height: 0;
        }

        /* En móvil la nota sobra; el botón de cerrar sesión se mantiene */
        .sidebar-note {
            display: none;
        }

        .logout-btn {
            font-size: 0.75rem;
            padding: 0.3rem 0.6rem;
        }

        /* Separación respecto al título del día / contenido */
        .sidebar:has(.sidebar-calendar-host) {
            padding-bottom: 1.15rem;
        }
    }
</style>
