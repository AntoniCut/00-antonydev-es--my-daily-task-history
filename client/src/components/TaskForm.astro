---
// Formulario para crear una tarea en el día seleccionado o editar una existente.
---

<form id="task-form" class="task-form">
  <h2 id="form-title" class="form-title">Nueva tarea</h2>
  <p id="form-date" class="form-date">Selecciona un día en el calendario</p>

  <div class="field">
    <label for="task-title">Título</label>
    <input
      id="task-title"
      name="title"
      type="text"
      placeholder="¿Qué hiciste o tienes que hacer?"
      required
      maxlength="120"
      disabled
    />
  </div>

  <div class="field">
    <label for="task-description">Descripción <span class="optional">(opcional)</span></label>
    <textarea
      id="task-description"
      name="description"
      rows="3"
      placeholder="Detalles de la actividad..."
      disabled
    ></textarea>
  </div>

  <div class="form-actions">
    <button id="form-submit" type="submit" class="btn-primary" disabled>Añadir tarea</button>
    <button id="form-cancel" type="button" class="btn-secondary" hidden>Cancelar</button>
  </div>

  <p id="form-error" class="form-error" role="alert" hidden></p>
</form>

<script>
  import { api } from '../lib/api';
  import { emitTasksChanged, onDateSelected, onEditTask } from '../lib/events';

  const MONTH_NAMES = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
  ];

  const form = document.getElementById('task-form') as HTMLFormElement;
  const formTitle = document.getElementById('form-title') as HTMLHeadingElement;
  const formDate = document.getElementById('form-date') as HTMLParagraphElement;
  const titleInput = document.getElementById('task-title') as HTMLInputElement;
  const descInput = document.getElementById('task-description') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('form-submit') as HTMLButtonElement;
  const cancelBtn = document.getElementById('form-cancel') as HTMLButtonElement;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

  let selectedDate: string | null = null;
  let editingId: string | null = null;

  function formatDate(dateKey: string): string {
    const [year, month, day] = dateKey.split('-').map(Number);
    return `${day} de ${MONTH_NAMES[month - 1]} de ${year}`;
  }

  function setInputsEnabled(enabled: boolean): void {
    titleInput.disabled = !enabled;
    descInput.disabled = !enabled;
    submitBtn.disabled = !enabled;
  }

  function showError(message: string | null): void {
    errorEl.hidden = !message;
    errorEl.textContent = message ?? '';
  }

  function resetForm(): void {
    editingId = null;
    form.reset();
    formTitle.textContent = 'Nueva tarea';
    submitBtn.textContent = 'Añadir tarea';
    cancelBtn.hidden = true;
    showError(null);
    if (selectedDate) {
      formDate.textContent = `Para el ${formatDate(selectedDate)}`;
      setInputsEnabled(true);
    }
  }

  onDateSelected((date) => {
    selectedDate = date;
    if (!editingId) {
      formDate.textContent = `Para el ${formatDate(date)}`;
      setInputsEnabled(true);
    }
  });

  onEditTask((task) => {
    editingId = task.id;
    titleInput.value = task.title;
    descInput.value = task.description ?? '';
    formTitle.textContent = 'Editar tarea';
    formDate.textContent = `Del ${formatDate(task.date)}`;
    submitBtn.textContent = 'Guardar cambios';
    cancelBtn.hidden = false;
    setInputsEnabled(true);
    showError(null);
    titleInput.focus();
  });

  cancelBtn.addEventListener('click', resetForm);

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const title = titleInput.value.trim();
    const description = descInput.value.trim();
    if (!title) return;

    const action = editingId
      ? api.updateTask(editingId, { title, description: description || undefined })
      : api.createTask({ title, description: description || undefined, date: selectedDate! });

    action
      .then(() => {
        resetForm();
        emitTasksChanged();
      })
      .catch((error: Error) => showError(error.message));
  });
</script>

<style>
  .task-form {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-title {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .form-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: -0.75rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .field input,
  .field textarea {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    resize: vertical;
    transition: border-color 0.15s ease;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .field input:disabled,
  .field textarea:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-primary {
    background-color: var(--color-primary);
    border: none;
    border-radius: 8px;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    transition: background-color 0.15s ease;
  }

  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-primary-hover);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 0.95rem;
    padding: 0.6rem 1.25rem;
    transition: background-color 0.15s ease;
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-hover);
  }

  .form-error {
    color: var(--color-danger);
    font-size: 0.85rem;
  }
</style>
