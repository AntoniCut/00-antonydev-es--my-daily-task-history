---
/*
 *  -----------------------------------------------------------------------------  *
 *  -----  ReportPanel.astro  --  /client/src/components/ReportPanel.astro  -----  *
 *  -----------------------------------------------------------------------------  *
 */

// Informe del tiempo invertido en un rango: totales por tarea y subtarea,
// reparto por día y exportación a CSV.
---

<div id="report-panel" class="report" data-loading>
    <form class="panel report-controls" data-form>
        <div class="field">
            <label for="report-range">Periodo</label>
            <select id="report-range" data-range>
                <option value="week">Esta semana</option>
                <option value="last-week">Semana anterior</option>
                <option value="month" selected>Este mes</option>
                <option value="last-month">Mes anterior</option>
                <option value="year">Este año</option>
                <option value="custom">Personalizado</option>
            </select>
        </div>

        <div class="field" data-custom hidden>
            <label for="report-from">Desde</label>
            <input id="report-from" type="date" data-from />
        </div>

        <div class="field" data-custom hidden>
            <label for="report-to">Hasta</label>
            <input id="report-to" type="date" data-to />
        </div>

        <button class="btn-secondary" type="submit">Actualizar</button>
        <button class="btn-secondary" type="button" data-export>
            Exportar CSV
        </button>
    </form>

    <div class="report-body">
        <section class="panel report-summary">
            <header class="report-header">
                <div>
                    <h2 class="panel-title" data-total>—</h2>
                    <p class="panel-subtitle" data-range-label></p>
                </div>
                <span class="badge" data-entries></span>
            </header>

            <p class="error-text" data-error role="alert" hidden></p>

            <ul class="report-list" data-list></ul>
            <p class="empty-text" data-empty hidden>
                No hay tiempo registrado en este periodo.
            </p>
        </section>

        <section class="panel report-days">
            <h2 class="panel-title">Reparto por día</h2>
            <ul class="day-list" data-days></ul>
            <p class="empty-text" data-days-empty hidden>Sin datos por día.</p>
        </section>
    </div>
</div>

<script>
    import { api } from '../lib/api';
    import { create, onPageReady, query, showError } from '../lib/dom';
    import { onDataChanged } from '../lib/events';
    import {
        addDays,
        formatDateShort,
        formatHours,
        formatMinutes,
        formatRange,
        formatWeekday,
        monthRange,
        todayKey,
        weekRange,
        yearRange,
        type DateRange,
    } from '../lib/time';
    import type { ReportSummary } from '../../types/types';

    onPageReady((signal) => {
        /*
            *  ---------------------------------  *
            *  -----  Referencias al HTML  -----  *
            *  ---------------------------------  *
        */

        // - `Panel raíz del informe`
        const root = document.getElementById('report-panel') as HTMLDivElement | null;
        if (!root) return;

        // - `Formulario de filtros del informe`
        const form = query<HTMLFormElement>(root, '[data-form]');

        // - `Selector del rango temporal`
        const rangeSelect = query<HTMLSelectElement>(root, '[data-range]');

        // - `Campo fecha inicial personalizada`
        const fromInput = query<HTMLInputElement>(root, '[data-from]');

        // - `Campo fecha final personalizada`
        const toInput = query<HTMLInputElement>(root, '[data-to]');

        // - `Bloques que contienen el rango personalizado`
        const customFields = [
            ...root.querySelectorAll<HTMLElement>('[data-custom]'),
        ];

        // - `Botón para exportar el informe a CSV`
        const exportBtn = query<HTMLButtonElement>(root, '[data-export]');

        // - `Título con el total del periodo`
        const totalEl = query<HTMLHeadingElement>(root, '[data-total]');

        // - `Etiqueta textual del rango activo`
        const rangeLabelEl = query<HTMLParagraphElement>(
            root,
            '[data-range-label]',
        );

        // - `Contador de registros del informe`
        const entriesEl = query<HTMLSpanElement>(root, '[data-entries]');

        // - `Mensaje de error del panel`
        const errorEl = query<HTMLParagraphElement>(root, '[data-error]');

        // - `Listado principal por tareas`
        const listEl = query<HTMLUListElement>(root, '[data-list]');

        // - `Estado vacío del resumen principal`
        const emptyEl = query<HTMLParagraphElement>(root, '[data-empty]');

        // - `Listado del reparto por día`
        const daysEl = query<HTMLUListElement>(root, '[data-days]');

        // - `Estado vacío del reparto diario`
        const daysEmptyEl = query<HTMLParagraphElement>(
            root,
            '[data-days-empty]',
        );

        let summary: ReportSummary | null = null;

        /**
         * ----------------------------------
         * -----  `resolveRange()`  -----
         * ----------------------------------
         * - Resuelve el rango temporal según la opción seleccionada.
         */
        const resolveRange = (): DateRange => {
            const today = todayKey();
            switch (rangeSelect.value) {
                case 'week':
                    return weekRange(today);
                case 'last-week':
                    return weekRange(addDays(today, -7));
                case 'last-month':
                    return monthRange(addDays(monthRange(today).from, -1));
                case 'year':
                    return yearRange(today);
                case 'custom':
                    return {
                        from: fromInput.value || today,
                        to: toInput.value || today,
                    };
                default:
                    return monthRange(today);
            }
        };

        /**
         * ----------------------------------------
         * -----  `bar(minutes, total, color)`  -----
         * ----------------------------------------
         * - Crea la barra visual: el 100% del track es el total del periodo.
         */
        const bar = (
            minutes: number,
            total: number,
            color: string,
        ): HTMLElement => {
            const track = create('span', { className: 'bar-track' });
            const fill = create('span', { className: 'bar-fill' });
            fill.style.width = `${total ? Math.max((minutes / total) * 100, 2) : 0}%`;
            fill.style.backgroundColor = color;
            track.appendChild(fill);
            return track;
        };

        /**
         * -----------------------------------
         * -----  `renderReport(report)`  -----
         * -----------------------------------
         * - Pinta el resumen principal y el reparto diario del informe.
         */
        const renderReport = (report: ReportSummary): void => {
            const tasks = report.tasks.filter((task) => task.minutes > 0);
            const totalMinutes = report.totalMinutes;

            totalEl.textContent = `${formatMinutes(report.totalMinutes)} · ${formatHours(report.totalMinutes)} h`;
            entriesEl.textContent = `${tasks.reduce((count, task) => count + task.entries, 0)} registros`;

            listEl.replaceChildren(
                ...tasks.map((task) => {
                    const item = create('li', { className: 'report-item' });

                    const row = create('div', { className: 'report-row' });
                    const rowHeader = create('div', {
                        className: 'report-row-header',
                    });
                    rowHeader.append(
                        create('span', {
                            className: 'report-title',
                            text: task.title,
                        }),
                        create('span', {
                            className: 'report-time',
                            text: formatMinutes(task.minutes),
                        }),
                        create('span', {
                            className: 'report-share',
                            text: report.totalMinutes
                                ? `${Math.round((task.minutes / report.totalMinutes) * 100)}%`
                                : '0%',
                        }),
                    );
                    row.append(
                        rowHeader,
                        bar(task.minutes, totalMinutes, task.color),
                    );
                    item.appendChild(row);

                    const children = [
                        ...(task.directMinutes
                            ? [
                                  {
                                      title: 'Sin subtarea',
                                      minutes: task.directMinutes,
                                  },
                              ]
                            : []),
                        ...task.subtasks.filter(
                            (subtask) => subtask.minutes > 0,
                        ),
                    ];

                    //  -----  si hay desglose hijo, renderizar la sublista  -----
                    if (children.length) {
                        const sublist = create('ul', {
                            className: 'report-sublist',
                        });
                        for (const child of children) {
                            const subItem = create('li', {
                                className: 'report-subitem',
                            });
                            const subHeader = create('div', {
                                className: 'report-row-header',
                            });
                            subHeader.append(
                                create('span', {
                                    className: 'report-title',
                                    text: child.title,
                                }),
                                create('span', {
                                    className: 'report-time',
                                    text: formatMinutes(child.minutes),
                                }),
                            );
                            subItem.append(
                                subHeader,
                                bar(child.minutes, totalMinutes, task.color),
                            );
                            sublist.appendChild(subItem);
                        }
                        item.appendChild(sublist);
                    }

                    return item;
                }),
            );
            emptyEl.hidden = tasks.length > 0;

            const maxDay = report.days.reduce(
                (top, day) => Math.max(top, day.minutes),
                0,
            );
            daysEl.replaceChildren(
                ...report.days.map((day) => {
                    const item = create('li', { className: 'day-item' });
                    item.append(
                        create('span', {
                            className: 'day-label',
                            text: `${formatWeekday(day.date).slice(0, 3)} ${formatDateShort(day.date)}`,
                        }),
                        bar(day.minutes, maxDay, 'var(--color-primary)'),
                        create('span', {
                            className: 'report-time',
                            text: formatMinutes(day.minutes),
                        }),
                    );
                    return item;
                }),
            );
            daysEmptyEl.hidden = report.days.length > 0;
        };

        /**
         * --------------------------
         * -----  `load()`  -----
         * --------------------------
         * - Carga el informe del rango actual y actualiza la vista.
         */
        const load = async (): Promise<void> => {
            const range = resolveRange();
            fromInput.value = range.from;
            toInput.value = range.to;
            rangeLabelEl.textContent = formatRange(range);

            try {
                summary = await api.getSummary(range);
                renderReport(summary);
                showError(errorEl, null);
            }
            //  -----  si la consulta falla, mostrar el error  -----
            catch (error) {
                showError(errorEl, (error as Error).message);
            } finally {
                root.removeAttribute('data-loading');
            }
        };

        /**
         * -------------------------------
         * -----  `csvCell(value)`  -----
         * -------------------------------
         * - Escapa una celda CSV para que sea segura en Excel.
         */
        const csvCell = (value: string): string =>
            `"${value.replaceAll('"', '""')}"`;

        /**
         * ----------------------------------------
         * -----  `downloadCsv(filename, rows)`  -----
         * ----------------------------------------
         * - Genera y descarga el archivo CSV del informe actual.
         */
        const downloadCsv = (filename: string, rows: string[][]): void => {
            const csv = rows
                .map((row) => row.map(csvCell).join(';'))
                .join('\r\n');
            const url = URL.createObjectURL(
                new Blob([`\uFEFF${csv}`], {
                    type: 'text/csv;charset=utf-8;',
                }),
            );
            const link = create('a', {
                attrs: { href: url, download: filename },
            });
            // Hay que insertarlo en el DOM; si no, algunos navegadores
            // descargan un archivo vacío o solo con la cabecera.
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            link.remove();
            window.setTimeout(() => URL.revokeObjectURL(url), 1_000);
        };

        /**
         * -------------------------------
         * -----  `exportCsv()`  -----
         * -------------------------------
         * - Exporta a CSV los registros del rango actualmente cargado.
         */
        const exportCsv = async (): Promise<void> => {
            //  -----  si todavía no hay resumen, no exportar  -----
            if (!summary) return;

            //  -----  rango vigente en el formulario (siempre relleno)  -----
            const range = { from: fromInput.value, to: toInput.value };

            try {
                const entries = await api.getEntries(range);

                //  -----  si no hay registros, mostrar un aviso visual  -----
                if (entries.length === 0) {
                    showError(
                        errorEl,
                        'No hay registros para exportar en este periodo.',
                    );
                    return;
                }

                const rows = [
                    [
                        'Fecha',
                        'Inicio',
                        'Fin',
                        'Tarea',
                        'Subtarea',
                        'Minutos',
                        'Horas',
                        'Actividad',
                    ],
                    ...entries.map((entry) => [
                        entry.date,
                        entry.start,
                        entry.end,
                        entry.taskTitle,
                        entry.subtaskTitle ?? '',
                        String(entry.minutes),
                        formatHours(entry.minutes),
                        (entry.note ?? '').replaceAll('\r\n', '\n'),
                    ]),
                ];

                downloadCsv(
                    `tiempo_${range.from}_${range.to}.csv`,
                    rows,
                );
                showError(errorEl, null);
            }
            //  -----  si la exportación falla, mostrar el error  -----
            catch (error) {
                showError(errorEl, (error as Error).message);
            }
        };

        rangeSelect.addEventListener(
            'change',
            () => {
                const isCustom = rangeSelect.value === 'custom';
                for (const field of customFields) field.hidden = !isCustom;

                //  -----  si el rango no es personalizado, recargar al instante  -----
                if (!isCustom) void load();
            },
            { signal },
        );

        form.addEventListener(
            'submit',
            (event: SubmitEvent) => {
                event.preventDefault();
                void load();
            },
            { signal },
        );

        exportBtn.addEventListener(
            'click',
            () => {
                void exportCsv();
            },
            { signal },
        );
        onDataChanged(() => void load(), { signal });

        void load();
    });
</script>

<style>
    .report {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
        height: 100%;
        min-height: 0;
        overflow: hidden;
    }

    .report-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 0.65rem;
        flex-shrink: 0;
    }

    .report-controls .field {
        min-width: 150px;
    }

    .report-controls button {
        height: 2.4rem;
    }

    .report-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-right: 0.15rem;
    }

    .report-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.7rem;
    }

    /* El rango llega con los datos: sin altura reservada la cabecera crece y
       empuja todo el informe hacia abajo. */
    .report-header .panel-subtitle {
        min-height: 1.28rem;
    }

    .report-days .panel-title {
        margin-bottom: 0.7rem;
    }

    .report-list,
    .day-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    /* El listado llega vacío del servidor: sin reservar hueco, al pintarlo
       empuja "Reparto por día" fuera de la pantalla de golpe. */
    .report[data-loading] .report-list {
        min-height: 55svh;
    }

    /* Filas generadas con JS: estilos scoped vía :global() */
    .report-list :global(.report-item) {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
    }

    .report-list :global(.report-row),
    .report-list :global(.report-subitem) {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .report-list :global(.report-row-header) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .day-list :global(.day-item) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .report-list :global(.report-sublist) {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        margin: 0.45rem 0 0 0.9rem;
        padding-left: 0.85rem;
        border-left: 2px solid var(--color-border);
    }

    .report-list :global(.report-title) {
        font-weight: 600;
        font-size: 0.9rem;
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .report-list :global(.report-subitem .report-title) {
        font-weight: 400;
        color: var(--color-text-muted);
    }

    .day-list :global(.day-label) {
        color: var(--color-text-muted);
        font-size: 0.82rem;
        width: 90px;
        flex-shrink: 0;
    }

    .report-list :global(.bar-track),
    .day-list :global(.bar-track) {
        height: 8px;
        background-color: var(--color-surface-hover);
        border-radius: 999px;
        overflow: hidden;
    }

    .report-list :global(.bar-track) {
        width: 100%;
    }

    .day-list :global(.bar-track) {
        flex: 1;
        min-width: 40px;
    }

    .report-list :global(.bar-fill),
    .day-list :global(.bar-fill) {
        display: block;
        height: 100%;
        border-radius: 999px;
    }

    .report-list :global(.report-time),
    .day-list :global(.report-time) {
        font-variant-numeric: tabular-nums;
        font-size: 0.85rem;
        text-align: right;
        flex-shrink: 0;
    }

    .report-list :global(.report-share) {
        color: var(--color-text-muted);
        font-size: 0.8rem;
        text-align: right;
        flex-shrink: 0;
    }

    @media (max-width: 560px) {
        .report-controls .field {
            min-width: min(150px, 100%);
        }

        .report-list :global(.report-sublist) {
            margin-left: 0.35rem;
            padding-left: 0.6rem;
        }

        .day-list :global(.day-item) {
            gap: 0.5rem;
        }

        .day-list :global(.day-label) {
            width: auto;
            flex: 0 0 4.6rem;
            font-size: 0.78rem;
        }

        .day-list :global(.report-time) {
            width: auto;
            min-width: 3.4rem;
        }

        .day-list :global(.bar-track) {
            min-width: 2rem;
        }
    }

    /* En pantallas pequeñas la página completa hace scroll. */
    @media (max-width: 900px) {
        .report {
            flex: none;
            height: auto;
            min-height: 0;
            max-height: none;
            overflow: visible;
        }

        .report-body {
            flex: none;
            min-height: 0;
            max-height: none;
            overflow-y: visible;
            overscroll-behavior: auto;
        }
    }
</style>
