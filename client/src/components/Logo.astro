---
/*
 *  ---------------------------------------------------------------  *
 *  -----  Logo.astro  --  /client/src/components/Logo.astro  -----  *
 *  ---------------------------------------------------------------  *
 */

// Logo del proyecto: mismo diseño que public/favicon.svg

interface Props {
    size?: number;
}

const { size = 48 } = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    width={size}
    height={size}
    role="img"
    aria-label="Logo de Mi Diario de Tareas"
    class="logo"
>
    <defs>
        <linearGradient id="logo-bg" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--logo-outer-top)"></stop>
            <stop offset="1" stop-color="var(--logo-outer-bottom)"></stop>
        </linearGradient>
    </defs>

    <rect width="64" height="64" rx="14" fill="url(#logo-bg)"></rect>

    <line
        x1="22"
        y1="9"
        x2="22"
        y2="17"
        stroke="var(--logo-ring)"
        stroke-width="3.5"
        stroke-linecap="round"></line>
    <line
        x1="42"
        y1="9"
        x2="42"
        y2="17"
        stroke="var(--logo-ring)"
        stroke-width="3.5"
        stroke-linecap="round"></line>

    <rect
        x="12"
        y="14"
        width="40"
        height="38"
        rx="6"
        fill="var(--logo-inner)"
        stroke="var(--logo-stroke)"
        stroke-width="2"></rect>

    <path
        d="M12 22 L12 20 A6 6 0 0 1 18 14 L46 14 A6 6 0 0 1 52 20 L52 22 Z"
        fill="var(--color-primary)"></path>

    <path
        d="M22 37 l7 7 l14 -15"
        fill="none"
        stroke="var(--color-success)"
        stroke-width="4.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
</svg>

<style>
    .logo {
        display: block;
        border-radius: 22%;
        box-shadow: var(--shadow);
        flex-shrink: 0;
    }
</style>
