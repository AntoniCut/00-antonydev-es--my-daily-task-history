---
/*
 *  ------------------------------------------------------------  *
 *  -----  index.astro  --  /client/src/pages/index.astro  -----  *
 *  ------------------------------------------------------------  *
 */
import Layout from '../layouts/Layout.astro';
import SummaryCards from '../components/SummaryCards.astro';
import Calendar from '../components/Calendar.astro';
import DayLog from '../components/DayLog.astro';
---

<Layout
    title="Dashboard — Gestor de tareas"
    heading="Dashboard"
    subtitle="Tiempo registrado hoy, esta semana y este mes"
    active="dashboard"
>
    <SummaryCards />

    <div class="dashboard-grid">
        <section aria-label="Calendario">
            <Calendar />
        </section>
        <DayLog />
    </div>
</Layout>

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: minmax(300px, 380px) 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    @media (max-width: 1000px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
