---
/*
 *  ------------------------------------------------------------  *
 *  -----  index.astro  --  /client/src/pages/index.astro  -----  *
 *  ------------------------------------------------------------  *
 */
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.astro';
---

<Layout
    title="Dashboard — Gestor de tareas"
    heading="Dashboard"
    subtitle="Selecciona un día para ver y registrar el tiempo"
    active="dashboard"
    fitViewport
>
    <section class="dashboard-calendar" aria-label="Calendario">
        <Calendar variant="large" />
    </section>
</Layout>

<style>
    .dashboard-calendar {
        width: 100%;
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem 2.5rem 1.75rem;
        overflow: hidden;
        box-sizing: border-box;
    }

    .dashboard-calendar :global(.calendar--large) {
        flex: 0 1 auto;
    }

    .dashboard-calendar :global(.calendar-grid) {
        flex: 1;
        min-height: 0;
    }

    @media (max-width: 900px) {
        .dashboard-calendar {
            padding: 0.75rem 0.5rem 1rem;
        }
    }
</style>
