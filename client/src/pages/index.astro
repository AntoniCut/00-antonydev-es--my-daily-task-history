---
/*
 *  ------------------------------------------------------------  *
 *  -----  index.astro  --  /client/src/pages/index.astro  -----  *
 *  ------------------------------------------------------------  *
 */
import Layout from '../layouts/Layout.astro';
import Calendar from '../components/Calendar.astro';
---

<Layout
    title="Dashboard — Gestor de tareas"
    heading="Dashboard"
    subtitle="Selecciona un día para ver y registrar el tiempo"
    active="dashboard"
    fitViewport
>
    <section class="dashboard-calendar" aria-label="Calendario">
        <Calendar variant="large" />
    </section>
</Layout>

<style>
    .dashboard-calendar {
        width: 100%;
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dashboard-calendar :global(.calendar) {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .dashboard-calendar :global(.calendar-grid) {
        flex: 1;
        min-height: 0;
    }
</style>
