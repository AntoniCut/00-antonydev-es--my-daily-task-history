---
/*
    *  ------------------------------------------------------------  *
    *  -----  login.astro  --  /client/src/pages/login.astro  -----  *
    *  ------------------------------------------------------------  *
*/

import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Acceso — Gestor de tareas"
    heading=""
    subtitle=""
    active="dashboard"
    public
    fitViewport
>
    <section class="login-wrap" aria-label="Inicio de sesión">
        <form class="login-card panel" id="login-form" novalidate>
            <h1 class="login-title">Acceso</h1>
            <p class="login-hint">Introduce tus credenciales para continuar</p>

            <div class="field">
                <label for="login-username">Usuario</label>
                <input
                    id="login-username"
                    name="username"
                    type="text"
                    autocomplete="username"
                    required
                />
            </div>

            <div class="field">
                <label for="login-password">Contraseña</label>
                <input
                    id="login-password"
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    required
                />
            </div>

            <p
                class="error-text login-error"
                id="login-error"
                role="alert"
                hidden
            >
            </p>

            <button
                type="submit"
                class="btn-primary login-submit"
                id="login-submit"
            >
                Entrar
            </button>
        </form>
    </section>
</Layout>

<script>
    import { api } from '../lib/api';
    import { onPageReady } from '../lib/dom';

    /**
     * -------------------------------
     * -----  `bindLogin()`  -----
     * -------------------------------
     * - Envía las credenciales al servidor y redirige si son válidas.
     */
    const bindLogin = (signal: AbortSignal): void => {
        /*
         *  ---------------------------------  *
         *  -----  Referencias al HTML  -----  *
         *  ---------------------------------  *
         */

        // - `Formulario de inicio de sesión`
        const form = document.getElementById(
            'login-form',
        ) as HTMLFormElement | null;

        //  -----  si no existe el formulario, salir  -----
        if (!form) return;

        // - `Contenedor del error de credenciales`
        const errorBox = document.getElementById(
            'login-error',
        ) as HTMLParagraphElement | null;

        // - `Botón de envío del formulario`
        const submit = document.getElementById(
            'login-submit',
        ) as HTMLButtonElement | null;

        // - `Campo del nombre de usuario`
        const usernameInput = document.getElementById(
            'login-username',
        ) as HTMLInputElement | null;

        // - `Campo de la contraseña`
        const passwordInput = document.getElementById(
            'login-password',
        ) as HTMLInputElement | null;

        /**
         * -------------------------------
         * -----  `showError()`  -----
         * -------------------------------
         * - Muestra el mensaje de error dentro del formulario.
         */
        const showError = (message: string): void => {
            if (!errorBox) return;
            errorBox.textContent = message;
            errorBox.hidden = false;
        };

        form.addEventListener(
            'submit',
            async (event: SubmitEvent): Promise<void> => {
                event.preventDefault();

                //  -----  si no están los campos, no se puede enviar  -----
                if (!usernameInput || !passwordInput) return;

                const username = usernameInput.value.trim();
                const password = passwordInput.value;

                //  -----  validación local: no enviar campos vacíos  -----
                if (!username || !password) {
                    showError('Introduce el usuario y la contraseña');
                    return;
                }

                //  -----  deshabilitar el botón mientras se envía  -----
                if (submit) {
                    submit.disabled = true;
                    submit.textContent = 'Entrando…';
                }

                try {
                    await api.login({ username, password });
                    window.location.replace('/');
                } catch (error) {
                    showError((error as Error).message);
                    if (submit) {
                        submit.disabled = false;
                        submit.textContent = 'Entrar';
                    }
                }
            },
            { signal },
        );
    };

    //  -----  se inicializa en cada carga de página  -----
    onPageReady(bindLogin);
</script>

<style>
    .login-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 24rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.8rem 1.6rem;
    }

    .login-title {
        font-size: 1.35rem;
    }

    .login-hint {
        color: var(--color-text-muted);
        font-size: 0.88rem;
        margin-top: -0.6rem;
    }

    .login-error {
        margin: 0;
    }

    .login-submit {
        width: 100%;
        padding-block: 0.65rem;
    }
</style>
